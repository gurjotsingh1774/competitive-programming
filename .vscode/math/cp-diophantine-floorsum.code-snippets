{
  "Two-Variable Linear Diophantine Equation Solver": {
    "prefix": "cp-dioph-2var",
    "body": [
      "#include<tuple>",
      "#include<numeric>",
      "",
      "// Returns {has_solution, x0, y0, g}",
      "struct DiophantineResult {",
      "    bool has_solution;",
      "    long long x0, y0, g;",
      "};",
      "",
      "DiophantineResult solveLinearDiophantine(long long a, long long b, long long c) {",
      "    if (a == 0 && b == 0) {",
      "        if (c == 0) return {true, 0, 0, 0};",
      "        return {false, 0, 0, 0};",
      "    }",
      "",
      "    long long x, y;",
      "    long long g = extended_gcd(std::abs(a), std::abs(b), x, y);",
      "",
      "    if (c % g != 0) {",
      "        return {false, 0, 0, g};",
      "    }",
      "",
      "    long long scale = c / g;",
      "    long long x0 = x * scale;",
      "    long long y0 = y * scale;",
      "",
      "    if (a < 0) x0 = -x0;",
      "    if (b < 0) y0 = -y0;",
      "",
      "    return {true, x0, y0, g};",
      "}"
    ],
    "description": "Finds particular and general solutions to a*x + b*y = c, and counts solutions in a bounded 2D box."
  },
  "N-Variable Linear Diophantine Equation Solver": {
    "prefix": "cp-dioph-nvar",
    "body": [
      "#include <vector>",
      "#include <numeric>",
      "#include <cmath>",
      "",
      "// Solves sum_{i=0}^{n-1} a[i] * x[i] = c for integer variables x[i]",
      "// Returns {has_solution, vector<long long> x, long long g}",
      "struct DiophantineNResult {",
      "    bool has_solution;",
      "    std::vector<long long> x;",
      "    long long g; // total gcd of all a[i]",
      "};",
      "",
      "DiophantineNResult solveLinearDiophantineN(const std::vector<long long> &a, long long c) {",
      "    int n = a.size();",
      "    if (n == 0) return {c == 0, {}, 0};",
      "",
      "    auto extgcd = [](auto self, long long a, long long b, long long &x, long long &y) -> long long {",
      "        if (b == 0) { x = 1; y = 0; return a; }",
      "        long long x1, y1;",
      "        long long g = self(self, b, a % b, x1, y1);",
      "        x = y1; y = x1 - y1 * (a / b);",
      "        return g;",
      "    };",
      "",
      "    std::vector<long long> g(n), u(n), v(n);",
      "    g[0] = a[0];",
      "    for (int i = 1; i < n; ++i) {",
      "        g[i] = extgcd(extgcd, g[i - 1], a[i], u[i], v[i]);",
      "    }",
      "",
      "    long long total_g = g.back();",
      "    if (total_g == 0) {",
      "        if (c == 0) return {true, std::vector<long long>(n, 0), 0};",
      "        return {false, {}, 0};",
      "    }",
      "    if (c % total_g != 0) {",
      "        return {false, {}, total_g};",
      "    }",
      "",
      "    // Unwind solutions backwards",
      "    std::vector<long long> x(n);",
      "    long long cur_c = c;",
      "    for (int i = n - 1; i >= 1; --i) {",
      "        long long scale = cur_c / g[i];",
      "        x[i] = (long long)((__int128)v[i] * scale);",
      "        cur_c -= (long long)((__int128)a[i] * x[i]);",
      "    }",
      "    x[0] = cur_c / a[0];",
      "",
      "    return {true, x, total_g};",
      "}"
    ],
    "description": "Solves a_1*x_1 + ... + a_n*x_n = c for integer variables x_i via sequential Extended GCD."
  },
  "Modulo Shortest Path (Frobenius Diophantine Solver)": {
    "prefix": "cp-dioph-frobenius",
    "body": [
      "#include <vector>",
      "#include <queue>",
      "#include <algorithm>",
      "",
      "// Solves sum a[i] * x[i] = d for x[i] >= 0 via Dijkstra modulo min(a[i])",
      "// Efficient when min(a[i]) <= 10^5 and d can be up to 10^18",
      "struct ModuloShortestPath {",
      "    long long m;",
      "    std::vector<long long> dist; // dist[r] = smallest value == r (mod m) representable",
      "",
      "    ModuloShortestPath() : m(0) {}",
      "    ModuloShortestPath(std::vector<long long> a) { init(a); }",
      "",
      "    void init(std::vector<long long> a) {",
      "        std::vector<long long> pos;",
      "        for (long long v : a) if (v > 0) pos.push_back(v);",
      "        std::sort(pos.begin(), pos.end());",
      "        pos.erase(std::unique(pos.begin(), pos.end()), pos.end());",
      "",
      "        if (pos.empty()) { m = 0; return; }",
      "        m = pos[0];",
      "        dist.assign(m, -1);",
      "",
      "        using P = std::pair<long long, int>;",
      "        std::priority_queue<P, std::vector<P>, std::greater<P>> pq;",
      "        dist[0] = 0;",
      "        pq.push({0, 0});",
      "",
      "        while (!pq.empty()) {",
      "            auto [d, u] = pq.top();",
      "            pq.pop();",
      "            if (d > dist[u]) continue;",
      "",
      "            for (size_t i = 1; i < pos.size(); ++i) {",
      "                long long w = pos[i];",
      "                int v = (u + w) % m;",
      "                if (dist[v] == -1 || dist[u] + w < dist[v]) {",
      "                    dist[v] = dist[u] + w;",
      "                    pq.push({dist[v], v});",
      "                }",
      "            }",
      "        }",
      "    }",
      "",
      "    // Query 1: Is d representable as sum a[i] * x[i] with x[i] >= 0? (O(1))",
      "    bool is_representable(long long d) const {",
      "        if (d < 0 || m == 0) return false;",
      "        if (d == 0) return true;",
      "        long long r = d % m;",
      "        return dist[r] != -1 && d >= dist[r];",
      "    }",
      "",
      "    // Query 2: Number of non-negative integers <= K representable (O(m))",
      "    long long count_representable_up_to(long long K) const {",
      "        if (K < 0 || m == 0) return 0;",
      "        long long count = 0;",
      "        for (int r = 0; r < m; ++r) {",
      "            if (dist[r] != -1 && K >= dist[r]) {",
      "                count += (K - dist[r]) / m + 1;",
      "            }",
      "        }",
      "        return count;",
      "    }",
      "",
      "    // Query 3: Largest unrepresentable integer (Frobenius number), or -1 if none/infinite",
      "    long long largest_unrepresentable() const {",
      "        if (m == 0) return -1;",
      "        long long max_d = 0;",
      "        for (int r = 0; r < m; ++r) {",
      "            if (dist[r] == -1) return -1;",
      "            max_d = std::max(max_d, dist[r]);",
      "        }",
      "        return max_d - m;",
      "    }",
      "};"
    ],
    "description": "Solves multivariable non-negative Linear Diophantine equations sum a_i*x_i = B (x_i >= 0) via Dijkstra."
  },
  "Linear Diophantine System with Two Equations": {
    "prefix": "cp-dioph-2eq-system",
    "body": [
      "#include <vector>",
      "#include <numeric>",
      "",
      "// Solves system of 2 linear Diophantine equations with n unknowns:",
      "// a[0]*x[0] + ... + a[n-1]*x[n-1] = c1",
      "// b[0]*x[0] + ... + b[n-1]*x[n-1] = c2",
      "// Returns {has_solution, vector<long long> x}",
      "struct Diophantine2EqResult {",
      "    bool has_solution;",
      "    std::vector<long long> x;",
      "};",
      "",
      "Diophantine2EqResult solveLinearDiophantine2Equations(",
      "    const std::vector<long long> &a,",
      "    const std::vector<long long> &b,",
      "    long long c1,",
      "    long long c2",
      ") {",
      "    int n = a.size();",
      "    if (n < 2) return {false, {}};",
      "",
      "    // Eliminate x[n-1] using a[n-1] and b[n-1]",
      "    long long an = a[n - 1], bn = b[n - 1];",
      "    std::vector<long long> A(n - 1);",
      "    for (int i = 0; i < n - 1; ++i) {",
      "        A[i] = a[i] * bn - b[i] * an;",
      "    }",
      "    long long C = c1 * bn - c2 * an;",
      "",
      "    // Solve eliminated equation in n - 1 variables",
      "    auto resN = solveLinearDiophantineN(A, C);",
      "    if (!resN.has_solution) return {false, {}};",
      "",
      "    std::vector<long long> x = resN.x;",
      "    x.push_back(0); // placeholder for x[n-1]",
      "",
      "    // Back-substitute into equation 1 or 2 to solve for x[n-1]",
      "    long long rem1 = c1;",
      "    for (int i = 0; i < n - 1; ++i) rem1 -= a[i] * x[i];",
      "    if (an != 0 && rem1 % an == 0) {",
      "        x[n - 1] = rem1 / an;",
      "        return {true, x};",
      "    }",
      "    long long rem2 = c2;",
      "    for (int i = 0; i < n - 1; ++i) rem2 -= b[i] * x[i];",
      "    if (bn != 0 && rem2 % bn == 0) {",
      "        x[n - 1] = rem2 / bn;",
      "        return {true, x};",
      "    }",
      "    return {false, {}};",
      "}"
    ],
    "description": "Solves a system of 2 linear Diophantine equations with n unknowns by variable elimination."
  },
  "Floor Sum (Lattice Points Under Line)": {
    "prefix": "cp-floor-sum",
    "body": [
      "inline ull floor_sum_unsigned(ull n, ull m, ull a, ull b) {",
      "    ull ans = 0;",
      "    while (true) {",
      "        if (a >= m) ans += n * (n - 1) / 2 * (a / m), a %= m;",
      "        if (b >= m) ans += n * (b / m), b %= m;",
      "        ull y_max = a * n + b;",
      "        if (y_max < m) break;",
      "        n = y_max / m, b = y_max % m;",
      "        swap(m, a);",
      "    }",
      "    return ans;",
      "}",
      "",
      "inline ll floor_sum(ll n, ll m, ll a, ll b) {",
      "    ll ans = 0;",
      "    if (a < 0) { ll a2 = ((a % m) + m) % m; ans -= n * (n - 1) / 2 * ((a2 - a) / m); a = a2; }",
      "    if (b < 0) { ll b2 = ((b % m) + m) % m; ans -= n * ((b2 - b) / m); b = b2; }",
      "    return ans + (ll)floor_sum_unsigned(n, m, a, b);",
      "}"
    ],
    "description": "Computes sum_{i=0}^{n-1} floor((a*i + b) / c) in O(log(a + c)) time via Euclidean coordinate swap."
  },
  "Generalized Floor Sum (f, g, h)": {
    "prefix": "cp-floor-sum-generalized",
    "body": [
      "#include <tuple>",
      "",
      "// Holds results of Generalized Floor Sum for i in [0, n - 1]:",
      "// f = sum floor((a*i + b)/c)",
      "// g = sum i * floor((a*i + b)/c)",
      "// h = sum floor((a*i + b)/c)^2",
      "struct FloorSumAll {",
      "    unsigned __int128 f;",
      "    unsigned __int128 g;",
      "    unsigned __int128 h;",
      "",
      "    // Sum of (a*i + b) % c",
      "    unsigned __int128 sum_mod(unsigned __int128 n, unsigned __int128 a, unsigned __int128 b, unsigned __int128 c) const {",
      "        return a * n * (n - 1) / 2 + b * n - c * f;",
      "    }",
      "",
      "    // Sum of i * ((a*i + b) % c)",
      "    unsigned __int128 sum_mod_i(unsigned __int128 n, unsigned __int128 a, unsigned __int128 b, unsigned __int128 c) const {",
      "        return a * n * (n - 1) * (2 * n - 1) / 6 + b * n * (n - 1) / 2 - c * g;",
      "    }",
      "",
      "    // Sum of ((a*i + b) % c)^2",
      "    unsigned __int128 sum_mod_sq(unsigned __int128 n, unsigned __int128 a, unsigned __int128 b, unsigned __int128 c) const {",
      "        unsigned __int128 sum_i = n * (n - 1) / 2;",
      "        unsigned __int128 sum_i2 = n * (n - 1) * (2 * n - 1) / 6;",
      "        return a * a * sum_i2 + 2 * a * b * sum_i + b * b * n - 2 * c * (a * g + b * f) + c * c * h;",
      "    }",
      "};",
      "",
      "// Computes f, g, h in O(log c) time using Euclidean reduction reciprocity",
      "FloorSumAll generalized_floor_sum(",
      "    unsigned __int128 n,",
      "    unsigned __int128 a,",
      "    unsigned __int128 b,",
      "    unsigned __int128 c",
      ") {",
      "    if (n == 0) return {0, 0, 0};",
      "    if (a == 0) {",
      "        unsigned __int128 q = b / c;",
      "        unsigned __int128 f = n * q;",
      "        unsigned __int128 g = q * n * (n - 1) / 2;",
      "        unsigned __int128 h = q * q * n;",
      "        return {f, g, h};",
      "    }",
      "    if (a >= c || b >= c) {",
      "        unsigned __int128 qa = a / c, ra = a % c;",
      "        unsigned __int128 qb = b / c, rb = b % c;",
      "        auto [f_rec, g_rec, h_rec] = generalized_floor_sum(n, ra, rb, c);",
      "",
      "        unsigned __int128 sum_i = n * (n - 1) / 2;",
      "        unsigned __int128 sum_i2 = n * (n - 1) * (2 * n - 1) / 6;",
      "",
      "        unsigned __int128 f = f_rec + qa * sum_i + qb * n;",
      "        unsigned __int128 g = g_rec + qa * sum_i2 + qb * sum_i;",
      "        unsigned __int128 h = h_rec + qa * qa * sum_i2 + qb * qb * n + ",
      "                             2 * qa * qb * sum_i + 2 * qa * g_rec + 2 * qb * f_rec;",
      "        return {f, g, h};",
      "    }",
      "",
      "    unsigned __int128 m = (a * (n - 1) + b) / c;",
      "    if (m == 0) return {0, 0, 0};",
      "",
      "    auto [f_rec, g_rec, h_rec] = generalized_floor_sum(m, c, c - b - 1, a);",
      "",
      "    unsigned __int128 f = m * (n - 1) - f_rec;",
      "    unsigned __int128 h = m * (m - 1) * (n - 1) - 2 * g_rec + f;",
      "    unsigned __int128 g = (m * n * (n - 1) - h_rec - f_rec) / 2;",
      "",
      "    return {f, g, h};",
      "}"
    ],
    "description": "Computes f = sum floor((ai+b)/c), g = sum i*floor((ai+b)/c), and h = sum floor((ai+b)/c)^2 in O(log(min(a, c)))."
  }
