{
  "Modular Arithmetic Basic Operations": {
    "prefix": "cp-mod-ops",
    "body": [
      "inline long long mod_add(long long a, long long b, long long mod) {",
      "    return ((a % mod) + (b % mod)) % mod;",
      "}",
      "",
      "inline long long mod_sub(long long a, long long b, long long mod) {",
      "    return (((a % mod) - (b % mod)) % mod + mod) % mod;",
      "}",
      "",
      "inline long long mod_mul(long long a, long long b, long long mod) {",
      "    return (long long)((unsigned __int128)(a % mod + mod) * (b % mod + mod) % mod);",
      "}"
    ],
    "description": "Safe scalar modular arithmetic operations (addition, subtraction, multiplication)."
  },
  "Modular Integer (mint)": {
    "prefix": "cp-mod-int",
    "body": [
      "#ifndef MOD_VALUE",
      "#define MOD_VALUE998244353",
      "#endif",
      "const int mod = MOD_VALUE;",
      "",
      "struct mint {",
      "    int x;",
      "    mint(ll v = 0) {",
      "        x = (int)(v % mod);",
      "        if (x < 0) x += mod;",
      "    }",
      "    int val() const { return x; }",
      "    mint &operator++() { if (++x == mod) x = 0; return *this; }",
      "    mint &operator--() { if (x == 0) x = mod; x--; return *this; }",
      "    mint operator++(int) { mint r = *this; ++*this; return r; }",
      "    mint operator--(int) { mint r = *this; --*this; return r; }",
      "    mint &operator+=(const mint &b) { x += b.x; if (x >= mod) x -= mod; return *this; }",
      "    mint &operator-=(const mint &b) { x -= b.x; if (x < 0) x += mod; return *this; }",
      "    mint &operator*=(const mint &b) { x = (int)((ll)x * b.x % mod); return *this; }",
      "    mint &operator/=(const mint &b) { return *this *= b.inv(); }",
      "    mint operator+() const { return *this; }",
      "    mint operator-() const { return mint() - *this; }",
      "    mint power(ll n) const {",
      "        mint a = *this, r = 1;",
      "        while (n) {",
      "            if (n & 1) r *= a;",
      "            a *= a;",
      "            n >>= 1;",
      "        }",
      "        return r;",
      "    }",
      "    mint inv() const { return power(mod - 2); }  // Prime modulus required",
      "    friend mint operator+(const mint &a, const mint &b) { return mint(a) += b; }",
      "    friend mint operator-(const mint &a, const mint &b) { return mint(a) -= b; }",
      "    friend mint operator*(const mint &a, const mint &b) { return mint(a) *= b; }",
      "    friend mint operator/(const mint &a, const mint &b) { return mint(a) /= b; }",
      "    friend bool operator==(const mint &a, const mint &b) { return a.x == b.x; }",
      "    friend bool operator!=(const mint &a, const mint &b) { return a.x != b.x; }",
      "    friend ostream &operator<<(ostream &os, const mint &o) { return os << o.x; }",
      "    friend istream &operator>>(istream &is, mint &o) { ll v; is >> v; o = mint(v); return is; }",
      "};",
      "using vm = vector<mint>;"
    ],
    "description": "Automatic wrapper struct for modular arithmetic under a prime modulus."
  },
  "Modular Exponentiation (power_mod)": {
    "prefix": "cp-mod-pow",
    "body": [
      "inline ll power_mod(ll a, ll b, ll m) {",
      "    ll r = 1 % m;",
      "    a %= m;",
      "    if (a < 0) a += m;",
      "    while (b) {",
      "        if (b & 1) r = (i128)r * a % m;",
      "        a = (i128)a * a % m;",
      "        b >>= 1;",
      "    }",
      "    return r;",
      "}"
    ],
    "description": "Computes a^b mod m in O(log b) time using binary exponentiation and 128-bit arithmetic."
  },
  "Extended GCD and Modular Inverse": {
    "prefix": "cp-mod-inv",
    "body": [
      "inline ll extended_gcd(ll a, ll b, ll &x, ll &y) {",
      "    if (!b) { x = 1, y = 0; return a; }",
      "    ll x1, y1, g = extended_gcd(b, a % b, x1, y1);",
      "    x = y1, y = x1 - (a / b) * y1;",
      "    return g;",
      "}",
      "",
      "inline ll mod_inverse(ll a, ll m) {",
      "    ll x, y, g = extended_gcd(((a % m) + m) % m, m, x, y);",
      "    return g == 1 ? ((x % m) + m) % m : -1;",
      "}"
    ],
    "description": "Solves a*x + b*y = gcd(a, b) and computes modular inverse in O(log(min(a, b)))."
  },
  "Wilson's Theorem (Factorial Modulo P)": {
    "prefix": "cp-mod-wilson",
    "body": [
      "// Wilson's Theorem: (p - 1)! == -1 == p - 1 (mod p) for prime p.",
      "// Computes n! % p in O(p - n + log p) time when n is close to p (p - n <= 10^7).",
      "// Useful when n is close to p (n < p) where standard O(n) factorial calculation would TLE.",
      "inline long long factorial_mod_wilson(long long n, long long p) {",
      "    if (n >= p) return 0;",
      "    if (n == p - 1) return p - 1;",
      "    // (p - 1)! = n! * (n + 1) * ... * (p - 1) == -1 (mod p)",
      "    // => n! == -1 * inv((n + 1) * ... * (p - 1)) (mod p)",
      "    long long prod = 1;",
      "    for (long long i = n + 1; i < p; ++i) {",
      "        prod = (unsigned __int128)prod * i % p;",
      "    }",
      "    // Fermat's Little Theorem: prod^(p - 2) == inv(prod) (mod p)",
      "    auto power_mod = [](long long a, long long b, long long m) -> long long {",
      "        long long res = 1;",
      "        a %= m;",
      "        for (; b > 0; b >>= 1, a = (unsigned __int128)a * a % m) {",
      "            if (b & 1) res = (unsigned __int128)res * a % m;",
      "        }",
      "        return res;",
      "    };",
      "    long long inv_prod = power_mod(prod, p - 2, p);",
      "    return (p - inv_prod) % p;",
      "}"
    ],
    "description": "Computes n! mod p in O(p - n + log p) time via Wilson's Theorem ((p-1)! == -1 mod p) when n is close to prime p (p - n <= 10^7)."
  },
  "Chinese Remainder Theorem (CRT)": {
    "prefix": "cp-mod-crt",
    "body": [
      "inline pair<ll, ll> crt(ll a1, ll m1, ll a2, ll m2) {",
      "    ll p, q, g = extended_gcd(m1, m2, p, q);",
      "    if ((a2 - a1) % g) return {-1, -1};",
      "    ll l = m1 / g * m2;",
      "    i128 t = (i128)((a2 - a1) / g) % (m2 / g) * (p % (m2 / g)) % (m2 / g);",
      "    i128 x = (i128)a1 + (i128)m1 * t;",
      "    x %= l;",
      "    if (x < 0) x += l;",
      "    return {(ll)x, l};",
      "}"
    ],
    "description": "Finds x mod lcm(m1, m2) satisfying simultaneous congruences for coprime or non-coprime moduli."
  },
  "Linear Congruence Equation Solver": {
    "prefix": "cp-mod-linear-congruence",
    "body": [
      "#include <vector>",
      "#include <numeric>",
      "",
      "// Solves a * x = b (mod m)",
      "// Returns all distinct solutions x in [0, m - 1] in ascending order.",
      "// If no solution exists, returns an empty vector.",
      "std::vector<long long> solveLinearCongruence(long long a, long long b, long long m) {",
      "    a = (a % m + m) % m;",
      "    b = (b % m + m) % m;",
      "",
      "    auto extgcd = [](auto self, long long a, long long b, long long &x, long long &y) -> long long {",
      "        if (b == 0) { x = 1; y = 0; return a; }",
      "        long long x1, y1;",
      "        long long g = self(self, b, a % b, x1, y1);",
      "        x = y1;",
      "        y = x1 - y1 * (a / b);",
      "        return g;",
      "    };",
      "",
      "    long long x, y;",
      "    long long g = extgcd(extgcd, a, m, x, y);",
      "",
      "    if (b % g != 0) return {};",
      "",
      "    long long step = m / g;",
      "    long long x0 = (long long)((__int128)((x % step + step) % step) * (b / g) % step);",
      "",
      "    std::vector<long long> solutions;",
      "    solutions.reserve(g);",
      "    for (long long t = 0; t < g; ++t) {",
      "        solutions.push_back(x0 + t * step);",
      "    }",
      "    return solutions;",
      "}"
    ],
    "description": "Solves a * x = b (mod m) and returns all gcd(a, m) distinct solutions in [0, m-1]."
  },
  "Baby-Step Giant-Step Discrete Logarithm": {
    "prefix": "cp-mod-discrete-log",
    "body": [
      "inline ll discrete_log(ll a, ll b, ll m) {",
      "    a %= m, b %= m;",
      "    if (a < 0) a += m;",
      "    if (b < 0) b += m;",
      "    if (m == 1) return 0;",
      "    ll k = 1 % m, add = 0, g;",
      "    while ((g = std::gcd(a, m)) > 1) {",
      "        if (b == k) return add;",
      "        if (b % g) return -1;",
      "        b /= g, m /= g, add++;",
      "        k = (i128)k * (a / g) % m;",
      "    }",
      "    if (b == k) return add;",
      "    ll n = (ll)sqrtl((long double)m) + 1, an = 1;",
      "    unordered_map<ll, ll> vals;",
      "    ll cur = b;",
      "    for (ll j = 0; j < n; j++) { vals[cur] = j; cur = (i128)cur * a % m; }",
      "    for (ll i = 0; i < n; i++) an = (i128)an * a % m;",
      "    cur = k;",
      "    for (ll i = 1; i <= n; i++) {",
      "        cur = (i128)cur * an % m;",
      "        auto it = vals.find(cur);",
      "        if (it != vals.end()) return i * n - it->second + add;",
      "    }",
      "    return -1;",
      "}"
    ],
    "description": "Solves a^x = b (mod m) for coprime or general moduli in O(sqrt(m)) time using baby-step giant-step."
  },
  "Primitive Root of Prime P": {
    "prefix": "cp-mod-primitive-root",
    "body": [
      "inline ll primitive_root(ll p) {",
      "    if (p == 2) return 1;",
      "    vector<ull> f = factorize_big(p - 1);",
      "    f.erase(unique(f.begin(), f.end()), f.end());",
      "    for (ll g = 2;; g++) {",
      "        bool ok = true;",
      "        for (ull q : f)",
      "            if (power_mod(g, (p - 1) / q, p) == 1) { ok = false; break; }",
      "        if (ok) return g;",
      "    }",
      "}"
    ],
    "description": "Finds the smallest primitive root modulo prime p by testing prime factors of p-1."
  },
  "Tonelli-Shanks Modular Square Root": {
    "prefix": "cp-mod-sqrt",
    "body": [
      "inline ll mod_sqrt(ll a, ll p) {",
      "    a %= p;",
      "    if (a < 0) a += p;",
      "    if (a == 0) return 0;",
      "    if (p == 2) return a;",
      "    if (power_mod(a, (p - 1) / 2, p) != 1) return -1;",
      "    ll q = p - 1, s = 0;",
      "    while (q % 2 == 0) q /= 2, s++;",
      "    ll z = 2;",
      "    while (power_mod(z, (p - 1) / 2, p) != p - 1) z++;",
      "    ll m = s, c = power_mod(z, q, p), t = power_mod(a, q, p), r = power_mod(a, (q + 1) / 2, p);",
      "    while (t != 1) {",
      "        ll i = 0, tt = t;",
      "        while (tt != 1) tt = (i128)tt * tt % p, i++;",
      "        ll b = c;",
      "        for (ll j = 0; j < m - i - 1; j++) b = (i128)b * b % p;",
      "        m = i, c = (i128)b * b % p, t = (i128)t * c % p, r = (i128)r * b % p;",
      "    }",
      "    return r;",
      "}"
    ],
    "description": "Solves x^2 = a (mod p) for odd prime p using the Tonelli-Shanks algorithm in O(log^2 p)."
  },
  "Discrete Root Solver": {
    "prefix": "cp-mod-discrete-root",
    "body": [
      "#include <vector>",
      "#include <numeric>",
      "#include <algorithm>",
      "#include <cmath>",
      "",
      "// Solves x^k = a (mod p) for prime p",
      "// Returns all solutions in [0, p - 1] in ascending order",
      "std::vector<long long> discrete_root(long long k, long long a, long long p) {",
      "    a %= p;",
      "    if (a < 0) a += p;",
      "    if (a == 0) return {0};",
      "    if (p == 2) return {a};",
      "",
      "    auto power_mod = [](long long base, long long exp, long long mod) -> long long {",
      "        long long res = 1 % mod; base %= mod;",
      "        while (exp > 0) {",
      "            if (exp & 1) res = (long long)((__int128)res * base % mod);",
      "            base = (long long)((__int128)base * base % mod);",
      "            exp >>= 1;",
      "        }",
      "        return res;",
      "    };",
      "",
      "    auto extgcd = [](auto self, long long a, long long b, long long &x, long long &y) -> long long {",
      "        if (b == 0) { x = 1; y = 0; return a; }",
      "        long long x1, y1;",
      "        long long g = self(self, b, a % b, x1, y1);",
      "        x = y1; y = x1 - y1 * (a / b);",
      "        return g;",
      "    };",
      "",
      "    auto mod_inv = [&](long long val, long long m) -> long long {",
      "        long long x, y;",
      "        long long g = extgcd(extgcd, (val % m + m) % m, m, x, y);",
      "        if (g != 1) return -1;",
      "        return (x % m + m) % m;",
      "    };",
      "",
      "    long long phi = p - 1;",
      "    long long g_k = std::gcd(k, phi);",
      "",
      "    // Fast path: unique solution via modular inverse",
      "    if (g_k == 1) {",
      "        long long inv_k = mod_inv(k, phi);",
      "        return {power_mod(a, inv_k, p)};",
      "    }",
      "",
      "    // Find primitive root modulo p",
      "    std::vector<long long> p_factors;",
      "    {",
      "        long long rem = phi;",
      "        for (long long d = 2; d * d <= rem; ++d) {",
      "            if (rem % d == 0) {",
      "                p_factors.push_back(d);",
      "                while (rem % d == 0) rem /= d;",
      "            }",
      "        }",
      "        if (rem > 1) p_factors.push_back(rem);",
      "    }",
      "",
      "    long long g = -1;",
      "    for (long long cand = 2; cand <= p; ++cand) {",
      "        bool ok = true;",
      "        for (long long q : p_factors) {",
      "            if (power_mod(cand, phi / q, p) == 1) { ok = false; break; }",
      "        }",
      "        if (ok) { g = cand; break; }",
      "    }",
      "    if (g == -1) return {};",
      "",
      "    // BSGS discrete log: g^alpha = a (mod p)",
      "    long long n = (long long)std::sqrt(p) + 1;",
      "    long long an = 1;",
      "    for (long long i = 0; i < n; ++i) an = (long long)((__int128)an * g % p);",
      "",
      "    std::vector<std::pair<long long, long long>> vals;",
      "    vals.reserve(n);",
      "    long long cur = a;",
      "    for (long long q = 0; q <= n; ++q) {",
      "        vals.push_back({cur, q});",
      "        cur = (long long)((__int128)cur * g % p);",
      "    }",
      "    std::sort(vals.begin(), vals.end());",
      "",
      "    long long alpha = -1;",
      "    cur = 1;",
      "    for (long long step_i = 1; step_i <= n; ++step_i) {",
      "        cur = (long long)((__int128)cur * an % p);",
      "        auto it = std::lower_bound(vals.begin(), vals.end(), std::make_pair(cur, -1LL));",
      "        if (it != vals.end() && it->first == cur) {",
      "            alpha = step_i * n - it->second;",
      "            break;",
      "        }",
      "    }",
      "",
      "    if (alpha == -1 || alpha % g_k != 0) return {};",
      "",
      "    long long step = phi / g_k;",
      "    long long y0 = (long long)((__int128)(alpha / g_k) * mod_inv(k / g_k, step) % step);",
      "    y0 = (y0 % step + step) % step;",
      "",
      "    std::vector<long long> roots;",
      "    roots.reserve(g_k);",
      "    for (long long t = 0; t < g_k; ++t) {",
      "        long long y = y0 + t * step;",
      "        roots.push_back(power_mod(g, y, p));",
      "    }",
      "    std::sort(roots.begin(), roots.end());",
      "    return roots;",
      "}"
    ],
    "description": "Solves x^k = a (mod p) for prime p and returns all solutions in [0, p-1] using primitive roots."
  },
  "Eulers Totient Function (Trial Division)": {
    "prefix": "cp-mod-totient",
    "body": [
      "inline long long euler_phi(long long n) {",
      "    long long r = n;",
      "    for (long long p = 2; p * p <= n; p++) {",
      "        if (n % p == 0) {",
      "            while (n % p == 0) n /= p;",
      "            r -= r / p;",
      "        }",
      "    }",
      "    if (n > 1) r -= r / n;",
      "    return r;",
      "}"
    ],
    "description": "Computes Eulers totient phi(n) via O(sqrt(n)) trial division factorization."
  }
