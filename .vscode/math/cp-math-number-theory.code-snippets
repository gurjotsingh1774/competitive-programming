    "body": [
      "#include <vector>",
      "",
      "// Solves LCM(F_{a_1}, F_{a_2}, ..., F_{a_n}) modulo mod in O(|D|) per query",
      "// Precomputes cyclotomic Fibonacci numbers C[i] via harmonic sieve in O(V log V)",
      "struct FibonacciLCM {",
      "    int max_v;",
      "    long long mod;",
      "    std::vector<long long> F;",
      "    std::vector<long long> C; // C[n] = primitive Fibonacci factors",
      "",
      "    static long long power_mod(long long base, long long exp, long long m) {",
      "        long long res = 1 % m; base %= m;",
      "        while (exp > 0) {",
      "            if (exp & 1) res = (long long)((__int128)res * base % m);",
      "            base = (long long)((__int128)base * base % m);",
      "            exp >>= 1;",
      "        }",
      "        return res;",
      "    }",
      "",
      "    FibonacciLCM(int v, long long m = 1000000007) : max_v(v), mod(m), F(v + 1), C(v + 1) {",
      "        if (v >= 1) F[1] = 1;",
      "        for (int i = 2; i <= v; ++i) {",
      "            F[i] = (F[i - 1] + F[i - 2]) % mod;",
      "        }",
      "",
      "        C = F;",
      "        for (int i = 1; i <= v; ++i) {",
      "            long long inv = power_mod(C[i], mod - 2, mod);",
      "            for (int j = 2 * i; j <= v; j += i) {",
      "                C[j] = (long long)((__int128)C[j] * inv % mod);",
      "            }",
      "        }",
      "    }",
      "",
      "    // Computes LCM(F_{a_1}, ..., F_{a_n}) modulo mod",
      "    long long query(const std::vector<long long> &a) const {",
      "        std::vector<bool> has_divisor(max_v + 1, false);",
      "        for (long long x : a) {",
      "            if (x <= 0 || x > max_v) continue;",
      "            for (long long d = 1; d * d <= x; ++d) {",
      "                if (x % d == 0) {",
      "                    has_divisor[d] = true;",
      "                    has_divisor[x / d] = true;",
      "                }",
      "            }",
      "        }",
      "",
      "        long long ans = 1;",
      "        for (int d = 1; d <= max_v; ++d) {",
      "            if (has_divisor[d]) {",
      "                ans = (long long)((__int128)ans * C[d] % mod);",
      "            }",
      "        }",
      "        return ans;",
      "    }",
      "};"
    ],
    "description": "Computes LCM(F_{a_1}, ..., F_{a_n}) modulo mod via multiplicative M\u00f6bius inversion on cyclotomic factors C_d where LCM = \\prod_{d \\in \bigcup \text{divisors}(a_i)} C_d. | Complexity: - **Precomputation:** O(V \\log V) - **Query:** O(n \\sqrt{V})"
  }
