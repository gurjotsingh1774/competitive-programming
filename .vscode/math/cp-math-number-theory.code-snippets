      "    while (true) {",
      "        if (a >= m) ans += n * (n - 1) / 2 * (a / m), a %= m;",
      "        if (b >= m) ans += n * (b / m), b %= m;",
      "        ull y_max = a * n + b;",
      "        if (y_max < m) break;",
      "        n = y_max / m, b = y_max % m;",
      "        swap(m, a);",
      "    }",
      "    return ans;",
      "}",
      "",
      "inline ll floor_sum(ll n, ll m, ll a, ll b) {",
      "    ll ans = 0;",
      "    if (a < 0) { ll a2 = ((a % m) + m) % m; ans -= n * (n - 1) / 2 * ((a2 - a) / m); a = a2; }",
      "    if (b < 0) { ll b2 = ((b % m) + m) % m; ans -= n * ((b2 - b) / m); b = b2; }",
      "    return ans + (ll)floor_sum_unsigned(n, m, a, b);",
      "}"
    ],
