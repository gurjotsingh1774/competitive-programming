  "Linear XOR Basis": {
    "prefix": "cp-alg-xor-basis",
    "body": [
      "// XorBasis: linear basis over GF(2) for values < 2^B. insert O(B), queries O(B).",
      "template <int B = 60> struct XorBasis {",
      "    ll b[B] = {};",
      "    int rank_ = 0;",
      "    bool insert(ll x) {  // true if x was independent",
      "        for (int i = B - 1; i >= 0; i--) {",
      "            if (!(x >> i & 1)) continue;",
      "            if (!b[i]) { b[i] = x, rank_++; return true; }",
      "            x ^= b[i];",
      "        }",
      "        return false;",
      "    }",
      "    bool contains(ll x) const {",
      "        for (int i = B - 1; i >= 0; i--) if ((x >> i & 1) && b[i]) x ^= b[i];",
      "        return x == 0;",
      "    }",
      "    ll max_xor(ll start = 0) const {  // maximum of start ^ (any subset xor)",
      "        ll r = start;",
      "        for (int i = B - 1; i >= 0; i--) if (b[i] && (r ^ b[i]) > r) r ^= b[i];",
      "        return r;",
      "    }",
      "    int rank() const { return rank_; }",
      "    // k-th smallest (0-indexed) element of the span, which has 2^rank elements (0 is smallest)",
      "    ll kth_smallest(ll k) const {",
      "        vector<ll> v;  // reduced basis, ascending by leading bit",
      "        ll c[B];",
      "        copy(b, b + B, c);",
      "        for (int i = 0; i < B; i++)",
      "            for (int j = 0; j < i; j++)",
      "                if ((c[i] >> j & 1) && c[j]) c[i] ^= c[j];",
      "        for (int i = 0; i < B; i++) if (c[i]) v.push_back(c[i]);",
      "        ll r = 0;",
      "        for (size_t i = 0; i < v.size(); i++) if (k >> i & 1) r ^= v[i];",
      "        return r;",
      "    }",
      "};"
    ],
    "description": "Linear vector basis over GF(2) for B-bit integers. Solves maximum XOR and k-th smallest XOR query."
  },
  "Matrix Algebra and Exponentiation": {
    "prefix": "cp-alg-matrix",
    "body": [
      "struct Matrix {",
      "    int n, m;",
      "    vector<vector<mint>> a;",
      "    Matrix(int n_ = 0, int m_ = 0) : n(n_), m(m_), a(n_, vector<mint>(m_, 0)) {}",
      "    static Matrix identity(int n) { Matrix r(n, n); for (int i = 0; i < n; i++) r.a[i][i] = 1; return r; }",
      "    Matrix operator*(const Matrix &o) const {",
      "        Matrix r(n, o.m);",
      "        for (int i = 0; i < n; i++)",
      "            for (int k = 0; k < m; k++)",
      "                if (a[i][k].x)",
      "                    for (int j = 0; j < o.m; j++)",
      "                        r.a[i][j] += a[i][k] * o.a[k][j];",
      "        return r;",
      "    }",
      "    Matrix power(ll e) const {",
      "        Matrix r = identity(n), b = *this;",
      "        for (; e; e >>= 1, b = b * b) if (e & 1) r = r * b;",
      "        return r;",
      "    }",
      "    mint det() const {",
      "        Matrix t = *this;",
      "        mint d = 1;",
      "        for (int c = 0; c < n; c++) {",
      "            int p = -1;",
      "            for (int r = c; r < n; r++) if (t.a[r][c].x) { p = r; break; }",
      "            if (p < 0) return 0;",
      "            if (p != c) swap(t.a[p], t.a[c]), d = -d;",
      "            d *= t.a[c][c];",
      "            mint iv = t.a[c][c].inv();",
      "            for (int r = c + 1; r < n; r++) {",
      "                mint f = t.a[r][c] * iv;",
      "                if (f.x) for (int k = c; k < n; k++) t.a[r][k] -= f * t.a[c][k];",
      "            }",
      "        }",
      "        return d;",
      "    }",
      "    int rank() const {",
      "        Matrix t = *this;",
      "        int rk = 0;",
      "        for (int c = 0; c < m && rk < n; c++) {",
      "            int p = -1;",
      "            for (int r = rk; r < n; r++) if (t.a[r][c].x) { p = r; break; }",
      "            if (p < 0) continue;",
      "            swap(t.a[p], t.a[rk]);",
      "            mint iv = t.a[rk][c].inv();",
      "            for (int r = rk + 1; r < n; r++) {",
      "                mint f = t.a[r][c] * iv;",
      "                if (f.x) for (int k = c; k < m; k++) t.a[r][k] -= f * t.a[rk][k];",
      "            }",
      "            rk++;",
      "        }",
      "        return rk;",
      "    }",
      "    bool inverse(Matrix &out) const {",
      "        Matrix t = *this;",
      "        out = identity(n);",
      "        for (int c = 0; c < n; c++) {",
      "            int p = -1;",
      "            for (int r = c; r < n; r++) if (t.a[r][c].x) { p = r; break; }",
      "            if (p < 0) return false;",
      "            swap(t.a[p], t.a[c]), swap(out.a[p], out.a[c]);",
      "            mint iv = t.a[c][c].inv();",
      "            for (int k = 0; k < n; k++) t.a[c][k] *= iv, out.a[c][k] *= iv;",
      "            for (int r = 0; r < n; r++) if (r != c && t.a[r][c].x) {",
      "                mint f = t.a[r][c];",
      "                for (int k = 0; k < n; k++)",
      "                    t.a[r][k] -= f * t.a[c][k], out.a[r][k] -= f * out.a[c][k];",
      "            }",
      "        }",
      "        return true;",
      "    }",
      "};"
    ],
    "description": "Matrix struct with cache-optimized multiplication and binary exponentiation over mint."
  },
  "Solving Linear Systems (Gaussian Elimination)": {
    "prefix": "cp-alg-solve-linear",
    "body": [
      "// Solves A x = b over Z_p. Returns false if inconsistent; otherwise one solution.",
      "inline bool solve_linear(Matrix A, vector<mint> b, vector<mint> &x) {",
      "    int n = A.n, m = A.m;",
      "    for (int i = 0; i < n; i++) A.a[i].push_back(b[i]);",
      "    vector<int> where(m, -1);",
      "    int row = 0;",
      "    for (int c = 0; c < m && row < n; c++) {",
      "        int p = -1;",
      "        for (int r = row; r < n; r++) if (A.a[r][c].x) { p = r; break; }",
      "        if (p < 0) continue;",
      "        swap(A.a[p], A.a[row]);",
      "        mint iv = A.a[row][c].inv();",
      "        for (int k = c; k <= m; k++) A.a[row][k] *= iv;",
      "        for (int r = 0; r < n; r++) if (r != row && A.a[r][c].x) {",
      "            mint f = A.a[r][c];",
      "            for (int k = c; k <= m; k++) A.a[r][k] -= f * A.a[row][k];",
      "        }",
      "        where[c] = row++;",
      "    }",
      "    for (int r = row; r < n; r++) if (A.a[r][m].x) return false;",
      "    x.assign(m, 0);",
      "    for (int c = 0; c < m; c++) if (where[c] >= 0) x[c] = A.a[where[c]][m];",
      "    return true;",
      "}"
    ],
    "description": "Solves matrix equation A*x = b over Z_p using Gaussian elimination with rank and solution analysis."
  }
