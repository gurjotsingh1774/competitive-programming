{
  "Mertens Function (Du Jiao Sieve)": {
    "prefix": "cp-dirichlet-mertens",
    "body": [
      "// Du Jiao Sieve for Mertens Function M(n) = sum_{i=1}^n mu(i) in O(n^(2/3)) time",
      "using ll = long long;",
      "using i128 = __int128_t;",
      "",
      "struct Mertens {",
      "    int B;",
      "    vector<int> mu;",
      "    vector<int> primes;",
      "    vector<bool> composite;",
      "    vector<ll> pref;",
      "    unordered_map<ll, ll> memo;",
      "",
      "    Mertens(ll n) {",
      "        B = (int)pow((long double)n, 2.0L / 3.0L);",
      "        B = max(B, 1);",
      "        mu.assign(B + 1, 0);",
      "        composite.assign(B + 1, false);",
      "        pref.assign(B + 1, 0);",
      "        build_sieve();",
      "        memo.reserve(1 << 16);",
      "    }",
      "",
      "    void build_sieve() {",
      "        mu[1] = 1;",
      "        for (int i = 2; i <= B; i++) {",
      "            if (!composite[i]) {",
      "                primes.push_back(i);",
      "                mu[i] = -1;",
      "            }",
      "            for (int p : primes) {",
      "                if (1LL * i * p > B) break;",
      "                composite[i * p] = true;",
      "                if (i % p == 0) {",
      "                    mu[i * p] = 0;",
      "                    break;",
      "                }",
      "                mu[i * p] = -mu[i];",
      "            }",
      "        }",
      "        for (int i = 1; i <= B; i++)",
      "            pref[i] = pref[i - 1] + mu[i];",
      "    }",
      "",
      "    ll solve(ll n) {",
      "        if (n <= B) return pref[n];",
      "        auto it = memo.find(n);",
      "        if (it != memo.end()) return it->second;",
      "        i128 ans = 1;",
      "        for (ll l = 2, r; l <= n; l = r + 1) {",
      "            ll q = n / l;",
      "            r = n / q;",
      "            ans -= (i128)(r - l + 1) * solve(q);",
      "        }",
      "        return memo[n] = (ll)ans;",
      "    }",
      "};"
    ],
    "description": "Calculates Mertens function M(n) = sum_{i=1}^n mu(i) in O(n^(2/3)) time and space via Du Jiao Sieve."
  },
  "Summatory Totient Function (Du Jiao Sieve)": {
    "prefix": "cp-dirichlet-totient",
    "body": [
      "// Du Jiao Sieve for Summatory Totient S_phi(n) = sum_{i=1}^n phi(i) in O(n^(2/3)) time",
      "using ll = long long;",
      "using i128 = __int128_t;",
      "",
      "struct SummatoryTotient {",
      "    int B;",
      "    vector<ll> phi;",
      "    vector<int> primes;",
      "    vector<bool> composite;",
      "    vector<ll> pref;",
      "    unordered_map<ll, ll> memo;",
      "",
      "    SummatoryTotient(ll n) {",
      "        B = (int)pow((long double)n, 2.0L / 3.0L);",
      "        B = max(B, 1);",
      "        phi.assign(B + 1, 0);",
      "        composite.assign(B + 1, false);",
      "        pref.assign(B + 1, 0);",
      "        build_sieve();",
      "        memo.reserve(1 << 16);",
      "    }",
      "",
      "    void build_sieve() {",
      "        phi[1] = 1;",
      "        for (int i = 2; i <= B; i++) {",
      "            if (!composite[i]) {",
      "                primes.push_back(i);",
      "                phi[i] = i - 1;",
      "            }",
      "            for (int p : primes) {",
      "                if (1LL * i * p > B) break;",
      "                composite[i * p] = true;",
      "                if (i % p == 0) {",
      "                    phi[i * p] = phi[i] * p;",
      "                    break;",
      "                }",
      "                phi[i * p] = phi[i] * (p - 1);",
      "            }",
      "        }",
      "        for (int i = 1; i <= B; i++)",
      "            pref[i] = pref[i - 1] + phi[i];",
      "    }",
      "",
      "    ll solve(ll n) {",
      "        if (n <= B) return pref[n];",
      "        auto it = memo.find(n);",
      "        if (it != memo.end()) return it->second;",
      "        i128 ans;",
      "        if (n % 2 == 0) ans = (i128)(n / 2) * (n + 1);",
      "        else ans = (i128)n * ((n + 1) / 2);",
      "        for (ll l = 2, r; l <= n; l = r + 1) {",
      "            ll q = n / l;",
      "            r = n / q;",
      "            ans -= (i128)(r - l + 1) * solve(q);",
      "        }",
      "        return memo[n] = (ll)ans;",
      "    }",
      "};"
    ],
    "description": "Calculates summatory totient function sum_{i=1}^n phi(i) in O(n^(2/3)) time and space via Du Jiao Sieve."
  },
  "Generic Dirichlet Prefix Solver (Du Jiao Sieve)": {
    "prefix": "cp-dirichlet-prefix-generic",
    "body": [
      "// Generic Dirichlet Prefix / Du Jiao Sieve structure in O(n^(2/3)) time",
      "using ll = long long;",
      "using i128 = __int128_t;",
      "",
      "struct DirichletPrefix {",
      "    ll N, B;",
      "    function<ll(ll)> pf, pg, pc;",
      "    unordered_map<ll, ll> memo;",
      "",
      "    DirichletPrefix(ll n, ll threshold, function<ll(ll)> _pf, function<ll(ll)> _pg, function<ll(ll)> _pc)",
      "        : N(n), B(threshold), pf(_pf), pg(_pg), pc(_pc) {}",
      "",
      "    ll solve(ll x) {",
      "        if (x <= 0) return 0;",
      "        if (x <= B) return pf(x);",
      "        auto it = memo.find(x);",
      "        if (it != memo.end()) return it->second;",
      "        i128 ans = pc(x);",
      "        for (ll l = 2, r; l <= x; l = r + 1) {",
      "            ll q = x / l;",
      "            r = x / q;",
      "            ll sumG = pg(r) - pg(l - 1);",
      "            ans -= (i128)sumG * solve(q);",
      "        }",
      "        ll g1 = pg(1);",
      "        ans /= g1;",
      "        return memo[x] = (ll)ans;",
      "    }",
      "};"
    ],
    "description": "Generic Du Jiao Sieve computing prefix sums of multiplicative functions via Dirichlet convolution in O(n^(2/3)) time."
  },
  "Coprime Pairs Counting (Du Jiao Sieve)": {
    "prefix": "cp-dirichlet-coprime-pairs",
    "body": [
      "// Count pairs (x, y) with 1 <= x, y <= n and gcd(x, y) = 1 in O(n^(2/3)) via Du Jiao Sieve",
      "long long count_coprime_pairs(long long n, Mertens &mt) {",
      "    long long ans = 0;",
      "    for (long long l = 1, r; l <= n; l = r + 1) {",
      "        long long q = n / l;",
      "        r = n / q;",
      "        ans += (mt.solve(r) - mt.solve(l - 1)) * q * q;",
      "    }",
      "    return ans;",
      "}"
    ],
    "description": "Counts ordered pairs (x, y) with gcd(x, y) = 1 up to n using Mertens function and quotient grouping in O(n^(2/3)) time."
  },
