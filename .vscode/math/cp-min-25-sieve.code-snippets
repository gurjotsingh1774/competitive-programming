{
  "Min_25 Sieve (Euler Totient Prefix Sum)": {
    "prefix": "cp-min25-totient",
    "body": [
      "// Min_25 Sieve: computes sum_{i=1}^n phi(i) in O(n^(3/4) / log n) time and O(sqrt(n)) space",
      "using ll = long long;",
      "",
      "struct Min25Totient {",
      "    ll n, sqrtN;",
      "    vector<ll> primes, sp0, sp1, vals;",
      "    int m;",
      "    vector<int> id1, id2;",
      "    vector<ll> G0, G1;",
      "",
      "    int get_id(ll v) const {",
      "        return (v <= sqrtN) ? id1[v] : id2[n / v];",
      "    }",
      "",
      "    Min25Totient(ll _n) : n(_n) {",
      "        if (n <= 0) return;",
      "        sqrtN = sqrt(n);",
      "        vector<bool> is_p(sqrtN + 1, true);",
      "        for (ll i = 2; i <= sqrtN; i++) {",
      "            if (is_p[i]) primes.push_back(i);",
      "            for (ll p : primes) {",
      "                if (i * p > sqrtN) break;",
      "                is_p[i * p] = false;",
      "                if (i % p == 0) break;",
      "            }",
      "        }",
      "        int num_p = primes.size();",
      "        sp0.assign(num_p + 1, 0);",
      "        sp1.assign(num_p + 1, 0);",
      "        for (int i = 0; i < num_p; i++) {",
      "            sp0[i + 1] = sp0[i] + 1;",
      "            sp1[i + 1] = sp1[i] + primes[i];",
      "        }",
      "",
      "        for (ll l = 1, r; l <= n; l = r + 1) {",
      "            ll v = n / l;",
      "            r = n / v;",
      "            vals.push_back(v);",
      "        }",
      "        m = vals.size();",
      "        id1.assign(sqrtN + 1, 0);",
      "        id2.assign(sqrtN + 1, 0);",
      "        for (int i = 0; i < m; i++) {",
      "            if (vals[i] <= sqrtN) id1[vals[i]] = i;",
      "            else id2[n / vals[i]] = i;",
      "        }",
      "",
      "        G0.assign(m, 0);",
      "        G1.assign(m, 0);",
      "        for (int i = 0; i < m; i++) {",
      "            ll v = vals[i];",
      "            G0[i] = v - 1;",
      "            if (v % 2 == 0) G1[i] = (v / 2) * (v + 1) - 1;",
      "            else G1[i] = v * ((v + 1) / 2) - 1;",
      "        }",
      "",
      "        for (int k = 0; k < num_p; k++) {",
      "            ll p = primes[k];",
      "            ll p2 = p * p;",
      "            for (int i = 0; i < m; i++) {",
      "                if (vals[i] < p2) break;",
      "                int id = get_id(vals[i] / p);",
      "                G0[i] -= (G0[id] - sp0[k]);",
      "                G1[i] -= p * (G1[id] - sp1[k]);",
      "            }",
      "        }",
      "    }",
      "",
      "    ll f_prime(ll v) const {",
      "        int id = get_id(v);",
      "        return G1[id] - G0[id];",
      "    }",
      "",
      "    ll F(int k, ll v) const {",
      "        if (v < primes[k]) return 0;",
      "        ll ans = f_prime(v) - (sp1[k] - sp0[k]);",
      "        for (int j = k; j < (int)primes.size() && primes[j] * primes[j] <= v; j++) {",
      "            ll p = primes[j];",
      "            ll pw = p;",
      "            for (int c = 1; pw * p <= v; c++, pw *= p) {",
      "                ll f_pc = pw - (pw / p);",
      "                ll f_next = pw * p - pw;",
      "                ans += f_pc * F(j + 1, v / pw) + f_next;",
      "            }",
      "        }",
      "        return ans;",
      "    }",
      "",
      "    ll solve() const {",
      "        if (n <= 0) return 0;",
      "        if (n == 1) return 1;",
      "        return F(0, n) + 1;",
      "    }",
      "};"
    ],
    "description": "Calculates sum_{i=1}^n phi(i) in O(n^(3/4) / log n) time and O(sqrt(n)) space via Min_25 Sieve."
  },
  "Min_25 Sieve (Mertens Function / M\u00f6bius Prefix Sum)": {
    "prefix": "cp-min25-mertens",
    "body": [
      "// Min_25 Sieve: computes Mertens function M(n) = sum_{i=1}^n mu(i) in O(n^(3/4) / log n) time and O(sqrt(n)) space",
      "using ll = long long;",
      "",
      "struct Min25Mertens {",
      "    ll n, sqrtN;",
      "    vector<ll> primes, sp0, vals;",
      "    int m;",
      "    vector<int> id1, id2;",
      "    vector<ll> G0;",
      "",
      "    int get_id(ll v) const {",
      "        return (v <= sqrtN) ? id1[v] : id2[n / v];",
      "    }",
      "",
      "    Min25Mertens(ll _n) : n(_n) {",
      "        if (n <= 0) return;",
      "        sqrtN = sqrt(n);",
      "        vector<bool> is_p(sqrtN + 1, true);",
      "        for (ll i = 2; i <= sqrtN; i++) {",
      "            if (is_p[i]) primes.push_back(i);",
      "            for (ll p : primes) {",
      "                if (i * p > sqrtN) break;",
      "                is_p[i * p] = false;",
      "                if (i % p == 0) break;",
      "            }",
      "        }",
      "        int num_p = primes.size();",
      "        sp0.assign(num_p + 1, 0);",
      "        for (int i = 0; i < num_p; i++) sp0[i + 1] = sp0[i] + 1;",
      "",
      "        for (ll l = 1, r; l <= n; l = r + 1) {",
      "            ll v = n / l;",
      "            r = n / v;",
      "            vals.push_back(v);",
      "        }",
      "        m = vals.size();",
      "        id1.assign(sqrtN + 1, 0);",
      "        id2.assign(sqrtN + 1, 0);",
      "        for (int i = 0; i < m; i++) {",
      "            if (vals[i] <= sqrtN) id1[vals[i]] = i;",
      "            else id2[n / vals[i]] = i;",
      "        }",
      "",
      "        G0.assign(m, 0);",
      "        for (int i = 0; i < m; i++) G0[i] = vals[i] - 1;",
      "",
      "        for (int k = 0; k < num_p; k++) {",
