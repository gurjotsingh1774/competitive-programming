      "            ll p2 = p * p;",
      "            for (int i = 0; i < m; i++) {",
      "                if (vals[i] < p2) break;",
      "                int id = get_id(vals[i] / p);",
      "                G0[i] -= (G0[id] - sp0[k]);",
      "            }",
      "        }",
      "    }",
      "",
      "    ll f_prime(ll v) const {",
      "        return -G0[get_id(v)];",
      "    }",
      "",
      "    ll F(int k, ll v) const {",
      "        if (v < primes[k]) return 0;",
      "        ll ans = f_prime(v) - (-sp0[k]);",
      "        for (int j = k; j < (int)primes.size() && primes[j] * primes[j] <= v; j++) {",
      "            ll p = primes[j];",
      "            ans += (-1) * F(j + 1, v / p);",
      "        }",
      "        return ans;",
      "    }",
      "",
      "    ll solve() const {",
      "        if (n <= 0) return 0;",
      "        if (n == 1) return 1;",
      "        return F(0, n) + 1;",
      "    }",
      "};"
    ],
    "description": "Calculates Mertens function M(n) = sum_{i=1}^n mu(i) in O(n^(3/4) / log n) time and O(sqrt(n)) space via Min_25 Sieve."
  },
