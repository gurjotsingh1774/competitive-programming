{
  "Linear XOR Basis": {
    "prefix": "cp-alg-xor-basis",
    "body": [
      "// XorBasis: linear basis over GF(2) for values < 2^B. insert O(B), queries O(B).",
      "template <int B = 60> struct XorBasis {",
      "    ll b[B] = {};",
      "    int rank_ = 0;",
      "    bool insert(ll x) {  // true if x was independent",
      "        for (int i = B - 1; i >= 0; i--) {",
      "            if (!(x >> i & 1)) continue;",
      "            if (!b[i]) { b[i] = x, rank_++; return true; }",
      "            x ^= b[i];",
      "        }",
      "        return false;",
      "    }",
      "    bool contains(ll x) const {",
      "        for (int i = B - 1; i >= 0; i--) if ((x >> i & 1) && b[i]) x ^= b[i];",
      "        return x == 0;",
      "    }",
      "    ll max_xor(ll start = 0) const {  // maximum of start ^ (any subset xor)",
      "        ll r = start;",
      "        for (int i = B - 1; i >= 0; i--) if (b[i] && (r ^ b[i]) > r) r ^= b[i];",
      "        return r;",
      "    }",
      "    int rank() const { return rank_; }",
      "    // k-th smallest (0-indexed) element of the span, which has 2^rank elements (0 is smallest)",
      "    ll kth_smallest(ll k) const {",
      "        vector<ll> v;  // reduced basis, ascending by leading bit",
      "        ll c[B];",
      "        copy(b, b + B, c);",
      "        for (int i = 0; i < B; i++)",
      "            for (int j = 0; j < i; j++)",
      "                if ((c[i] >> j & 1) && c[j]) c[i] ^= c[j];",
      "        for (int i = 0; i < B; i++) if (c[i]) v.push_back(c[i]);",
      "        ll r = 0;",
      "        for (size_t i = 0; i < v.size(); i++) if (k >> i & 1) r ^= v[i];",
      "        return r;",
      "    }",
      "};"
    ],
    "description": "Linear vector basis over GF(2) for B-bit integers. Solves maximum XOR and k-th smallest XOR query."
  },
  "Matrix Algebra and Exponentiation": {
    "prefix": "cp-alg-matrix",
    "body": [
      "struct Matrix {",
      "    int n, m;",
      "    vector<vector<mint>> a;",
      "    Matrix(int n_ = 0, int m_ = 0) : n(n_), m(m_), a(n_, vector<mint>(m_, 0)) {}",
      "    static Matrix identity(int n) { Matrix r(n, n); for (int i = 0; i < n; i++) r.a[i][i] = 1; return r; }",
      "    Matrix operator*(const Matrix &o) const {",
      "        Matrix r(n, o.m);",
      "        for (int i = 0; i < n; i++)",
      "            for (int k = 0; k < m; k++)",
      "                if (a[i][k].x)",
      "                    for (int j = 0; j < o.m; j++)",
      "                        r.a[i][j] += a[i][k] * o.a[k][j];",
      "        return r;",
      "    }",
      "    Matrix power(ll e) const {",
      "        Matrix r = identity(n), b = *this;",
      "        for (; e; e >>= 1, b = b * b) if (e & 1) r = r * b;",
      "        return r;",
      "    }",
      "    mint det() const {",
      "        Matrix t = *this;",
      "        mint d = 1;",
      "        for (int c = 0; c < n; c++) {",
      "            int p = -1;",
      "            for (int r = c; r < n; r++) if (t.a[r][c].x) { p = r; break; }",
      "            if (p < 0) return 0;",
      "            if (p != c) swap(t.a[p], t.a[c]), d = -d;",
      "            d *= t.a[c][c];",
      "            mint iv = t.a[c][c].inv();",
      "            for (int r = c + 1; r < n; r++) {",
      "                mint f = t.a[r][c] * iv;",
      "                if (f.x) for (int k = c; k < n; k++) t.a[r][k] -= f * t.a[c][k];",
      "            }",
      "        }",
      "        return d;",
      "    }",
      "    int rank() const {",
      "        Matrix t = *this;",
      "        int rk = 0;",
      "        for (int c = 0; c < m && rk < n; c++) {",
      "            int p = -1;",
      "            for (int r = rk; r < n; r++) if (t.a[r][c].x) { p = r; break; }",
      "            if (p < 0) continue;",
      "            swap(t.a[p], t.a[rk]);",
      "            mint iv = t.a[rk][c].inv();",
      "            for (int r = rk + 1; r < n; r++) {",
      "                mint f = t.a[r][c] * iv;",
      "                if (f.x) for (int k = c; k < m; k++) t.a[r][k] -= f * t.a[rk][k];",
      "            }",
      "            rk++;",
      "        }",
      "        return rk;",
      "    }",
      "    bool inverse(Matrix &out) const {",
      "        Matrix t = *this;",
      "        out = identity(n);",
      "        for (int c = 0; c < n; c++) {",
      "            int p = -1;",
      "            for (int r = c; r < n; r++) if (t.a[r][c].x) { p = r; break; }",
      "            if (p < 0) return false;",
      "            swap(t.a[p], t.a[c]), swap(out.a[p], out.a[c]);",
      "            mint iv = t.a[c][c].inv();",
      "            for (int k = 0; k < n; k++) t.a[c][k] *= iv, out.a[c][k] *= iv;",
      "            for (int r = 0; r < n; r++) if (r != c && t.a[r][c].x) {",
      "                mint f = t.a[r][c];",
      "                for (int k = 0; k < n; k++)",
      "                    t.a[r][k] -= f * t.a[c][k], out.a[r][k] -= f * out.a[c][k];",
      "            }",
      "        }",
      "        return true;",
      "    }",
      "};"
    ],
    "description": "Matrix struct with cache-optimized multiplication and binary exponentiation over mint."
  },
  "Solving Linear Systems (Gaussian Elimination)": {
    "prefix": "cp-alg-solve-linear",
    "body": [
      "// Solves A x = b over Z_p. Returns false if inconsistent; otherwise one solution.",
      "inline bool solve_linear(Matrix A, vector<mint> b, vector<mint> &x) {",
      "    int n = A.n, m = A.m;",
      "    for (int i = 0; i < n; i++) A.a[i].push_back(b[i]);",
      "    vector<int> where(m, -1);",
      "    int row = 0;",
      "    for (int c = 0; c < m && row < n; c++) {",
      "        int p = -1;",
      "        for (int r = row; r < n; r++) if (A.a[r][c].x) { p = r; break; }",
      "        if (p < 0) continue;",
      "        swap(A.a[p], A.a[row]);",
      "        mint iv = A.a[row][c].inv();",
      "        for (int k = c; k <= m; k++) A.a[row][k] *= iv;",
      "        for (int r = 0; r < n; r++) if (r != row && A.a[r][c].x) {",
      "            mint f = A.a[r][c];",
      "            for (int k = c; k <= m; k++) A.a[r][k] -= f * A.a[row][k];",
      "        }",
      "        where[c] = row++;",
      "    }",
      "    for (int r = row; r < n; r++) if (A.a[r][m].x) return false;",
      "    x.assign(m, 0);",
      "    for (int c = 0; c < m; c++) if (where[c] >= 0) x[c] = A.a[where[c]][m];",
      "    return true;",
      "}"
    ],
    "description": "Solves matrix equation A*x = b over Z_p using Gaussian elimination with rank and solution analysis."
  },
  "Number Theoretic Transform (NTT)": {
    "prefix": "cp-poly-ntt",
    "body": [
      "static_assert(mod == 998244353, \"poly.md needs MOD_VALUE 998244353 for NTT\");",
      "",
      "inline void ntt(vector<mint> &a, bool invert) {",
      "    int n = a.size();",
      "    for (int i = 1, j = 0; i < n; i++) {",
      "        int bit = n >> 1;",
      "        for (; j & bit; bit >>= 1) j ^= bit;",
      "        j ^= bit;",
      "        if (i < j) swap(a[i], a[j]);",
      "    }",
      "    for (int len = 2; len <= n; len <<= 1) {",
      "        mint w(mint(3).power((mod - 1) / len));",
      "        if (invert) w = w.inv();",
      "        for (int i = 0; i < n; i += len) {",
      "            mint cur = 1;",
      "            for (int j = 0; j < len / 2; j++) {",
      "                mint u = a[i + j], v = a[i + j + len / 2] * cur;",
      "                a[i + j] = u + v, a[i + j + len / 2] = u - v;",
      "                cur *= w;",
      "            }",
      "        }",
      "    }",
      "    if (invert) { mint ni = mint(n).inv(); for (auto &x : a) x *= ni; }",
      "}"
    ],
    "description": "Computes NTT modulo 998244353 in-place in O(N log N) time."
  },
  "Polynomial Convolution": {
    "prefix": "cp-poly-conv",
    "body": [
      "inline vector<mint> convolution(vector<mint> a, vector<mint> b) {",
      "    if (a.empty() || b.empty()) return {};",
      "    size_t need = a.size() + b.size() - 1;",
      "    if (min(a.size(), b.size()) <= 16) {",
      "        vector<mint> r(need);",
      "        for (size_t i = 0; i < a.size(); i++)",
      "            for (size_t j = 0; j < b.size(); j++)",
      "                r[i + j] += a[i] * b[j];",
      "        return r;",
      "    }",
      "    size_t n = 1;",
      "    while (n < need) n <<= 1;",
      "    a.resize(n), b.resize(n);",
      "    ntt(a, false), ntt(b, false);",
      "    for (size_t i = 0; i < n; i++) a[i] *= b[i];",
      "    ntt(a, true);",
      "    a.resize(need);",
      "    return a;",
      "}"
    ],
    "description": "Multiplies two polynomials A(x) and B(x) modulo 998244353 using NTT in O((n+m) log(n+m))."
  },
  "Polynomial Inverse Series": {
    "prefix": "cp-poly-inv",
    "body": [
      "inline vector<mint> poly_inverse(const vector<mint> &f, int n) {",
      "    vector<mint> g = {f[0].inv()};",
      "    for (int len = 1; len < n; len <<= 1) {",
      "        vector<mint> fc(f.begin(), f.begin() + min((int)f.size(), 2 * len));",
      "        auto t = convolution(fc, convolution(g, g));",
      "        t.resize(2 * len);",
      "        vector<mint> ng(2 * len);",
      "        for (int i = 0; i < 2 * len; i++)",
      "            ng[i] = (i < (int)g.size() ? g[i] * 2 : mint(0)) - t[i];",
      "        g = ng;",
      "    }",
      "    g.resize(n);",
      "    return g;",
      "}"
    ],
    "description": "Computes formal power series inverse g(x) such that f(x)*g(x) = 1 (mod x^deg) via Newton inversion."
  },
  "Lagrange Interpolation (Consecutive Points)": {
    "prefix": "cp-poly-lagrange",
    "body": [
      "inline mint lagrange_consecutive(const vector<mint> &y, mint x) {",
      "    int n = y.size();",
      "    if ((ll)x.val() < n) return y[x.val()];",
      "    vector<mint> pfx(n + 1, 1), sfx(n + 1, 1), fi(n, 1);",
      "    for (int i = 0; i < n; i++) pfx[i + 1] = pfx[i] * (x - i);",
      "    for (int i = n - 1; i >= 0; i--) sfx[i] = sfx[i + 1] * (x - i);",
      "    mint fprod = 1;",
      "    for (int i = 1; i < n; i++) fprod *= i;",
      "    fi[n - 1] = fprod.inv();",
      "    for (int i = n - 1; i > 0; i--) fi[i - 1] = fi[i] * i;",
      "    mint res = 0;",
      "    for (int i = 0; i < n; i++) {",
      "        mint term = y[i] * pfx[i] * sfx[i + 1] * fi[i] * fi[n - 1 - i];",
      "        res += ((n - 1 - i) & 1) ? -term : term;",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Evaluates degree-d polynomial at query point x from values at 0, 1, ..., d in O(d) time."
  },
  "kth Term of Linear Recurrence (Bostan-Mori)": {
    "prefix": "cp-poly-bostan-mori",
    "body": [
      "inline mint kth_term(const vector<mint> &c, const vector<mint> &a, ll k) {",
      "    int d = c.size();",
      "    if (k < (ll)a.size()) return a[k];",
      "    auto mul = [&](const vector<mint> &p, const vector<mint> &q) {",
      "        vector<mint> r(2 * d - 1);",
      "        for (int i = 0; i < d; i++)",
      "            for (int j = 0; j < d; j++)",
      "                r[i + j] += p[i] * q[j];",
      "        for (int i = 2 * d - 2; i >= d; i--)",
      "            for (int j = 0; j < d; j++)",
      "                r[i - 1 - j] += r[i] * c[j];",
      "        r.resize(d);",
      "        return r;",
      "    };",
      "    vector<mint> res(d), base(d);",
      "    res[0] = 1;",
      "    if (d == 1) base[0] = c[0]; else base[1] = 1;",
      "    for (ll e = k; e; e >>= 1) {",
      "        if (e & 1) res = mul(res, base);",
      "        base = mul(base, base);",
      "    }",
      "    mint ans = 0;",
      "    for (int i = 0; i < d; i++) ans += res[i] * a[i];",
      "    return ans;",
      "}"
    ],
    "description": "Finds k-th term of linear recurrence in O(d log d log k) via polynomial modulo exponentiation."
  },
  "Complex Fast Fourier Transform (FFT)": {
    "prefix": "cp-poly-fft",
    "body": [
      "using cd = complex<double>;",
      "const double PI = acos(-1.0);",
      "",
      "// In-place iterative Radix-2 Cooley-Tukey FFT",
      "inline void fft(vector<cd> &a, bool invert) {",
      "    int n = a.size();",
      "    for (int i = 1, j = 0; i < n; i++) {",
      "        int bit = n >> 1;",
      "        for (; j & bit; bit >>= 1) j ^= bit;",
      "        j ^= bit;",
      "        if (i < j) swap(a[i], a[j]);",
      "    }",
      "    for (int len = 2; len <= n; len <<= 1) {",
      "        double ang = 2 * PI / len * (invert ? -1 : 1);",
      "        cd wlen(cos(ang), sin(ang));",
      "        for (int i = 0; i < n; i += len) {",
      "            cd w(1);",
      "            for (int j = 0; j < len / 2; j++) {",
      "                cd u = a[i + j], v = a[i + j + len / 2] * w;",
      "                a[i + j] = u + v;",
      "                a[i + j + len / 2] = u - v;",
      "                w *= wlen;",
      "            }",
      "        }",
      "    }",
      "    if (invert) {",
      "        for (cd &x : a) x /= n;",
      "    }",
      "}",
      "",
      "// Multiplies two polynomials using complex FFT",
      "inline vector<long long> multiply_fft(const vector<long long> &a, const vector<long long> &b) {",
      "    if (a.empty() || b.empty()) return {};",
      "    vector<cd> fa(a.begin(), a.end()), fb(b.begin(), b.end());",
      "    int n = 1;",
      "    while (n < (int)(a.size() + b.size())) n <<= 1;",
      "    fa.resize(n); fb.resize(n);",
      "    fft(fa, false); fft(fb, false);",
      "    for (int i = 0; i < n; i++) fa[i] *= fb[i];",
      "    fft(fa, true);",
      "    vector<long long> res(a.size() + b.size() - 1);",
      "    for (size_t i = 0; i < res.size(); i++)",
      "        res[i] = round(fa[i].real());",
      "    return res;",
      "}"
    ],
    "description": "In-place iterative Radix-2 Cooley-Tukey complex FFT for general polynomial multiplication."
  },
  "Arbitrary Modulus Convolution (MTT / Split FFT)": {
    "prefix": "cp-poly-mtt",
    "body": [
      "// Multiplies two polynomials modulo any arbitrary modulus m using 4-FFT MTT",
      "inline vector<long long> convolution_arbitrary_mod(const vector<long long> &a, const vector<long long> &b, long long m) {",
      "    if (a.empty() || b.empty()) return {};",
      "    size_t need = a.size() + b.size() - 1;",
      "    size_t n = 1;",
      "    while (n < need) n <<= 1;",
      "",
      "    const long long B = 32768; // 2^15 split boundary",
      "    vector<cd> a1(n), a2(n), b1(n), b2(n);",
      "    for (size_t i = 0; i < a.size(); i++) {",
      "        long long val = (a[i] % m + m) % m;",
      "        a1[i] = val / B; a2[i] = val % B;",
      "    }",
      "    for (size_t i = 0; i < b.size(); i++) {",
      "        long long val = (b[i] % m + m) % m;",
      "        b1[i] = val / B; b2[i] = val % B;",
      "    }",
      "",
      "    fft(a1, false); fft(a2, false);",
      "    fft(b1, false); fft(b2, false);",
      "",
      "    vector<cd> c1(n), c2(n), c3(n);",
      "    for (size_t i = 0; i < n; i++) {",
      "        c1[i] = a1[i] * b1[i];",
      "        c2[i] = a1[i] * b2[i] + a2[i] * b1[i];",
      "        c3[i] = a2[i] * b2[i];",
      "    }",
      "",
      "    fft(c1, true); fft(c2, true); fft(c3, true);",
      "",
      "    vector<long long> res(need);",
      "    long long B2 = (B * B) % m;",
      "    for (size_t i = 0; i < need; i++) {",
      "        long long v1 = (long long)round(c1[i].real()) % m;",
      "        long long v2 = (long long)round(c2[i].real()) % m;",
      "        long long v3 = (long long)round(c3[i].real()) % m;",
      "        res[i] = (v1 * B2 + v2 * B + v3) % m;",
      "        if (res[i] < 0) res[i] += m;",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Multiplies polynomials modulo any integer M (e.g. 10^9+7) using 4-FFT complex splitting."
  },
  "All-Pairs Sums and Differences (Frequency Convolutions)": {
    "prefix": "cp-poly-all-pairs-sum",
    "body": [
      "// Returns count of pairs (a_i, b_j) with sum s at index s",
      "inline vector<long long> all_pairs_sum(const vector<int> &a, const vector<int> &b) {",
      "    if (a.empty() || b.empty()) return {};",
      "    int max_a = *max_element(a.begin(), a.end());",
      "    int max_b = *max_element(b.begin(), b.end());",
      "    vector<long long> fa(max_a + 1, 0), fb(max_b + 1, 0);",
      "    for (int x : a) fa[x]++;",
      "    for (int y : b) fb[y]++;",
      "    return multiply_fft(fa, fb);",
      "}",
      "",
      "// Returns count of pairs (a_i, b_j) with difference d at index (d + offset)",
      "inline vector<long long> all_pairs_diff(const vector<int> &a, const vector<int> &b) {",
      "    if (a.empty() || b.empty()) return {};",
      "    int max_a = *max_element(a.begin(), a.end());",
      "    int max_b = *max_element(b.begin(), b.end());",
      "    vector<long long> fa(max_a + 1, 0), fb(max_b + 1, 0);",
      "    for (int x : a) fa[x]++;",
      "    for (int y : b) fb[max_b - y]++; // Reverse b to turn difference into sum",
      "    return multiply_fft(fa, fb);",
      "}"
    ],
    "description": "Frequency convolution counting all pairwise sums a_i + b_j and differences a_i - b_j in O(V log V)."
  },
  "All Cyclic Scalar Products (Circular Convolution)": {
    "prefix": "cp-poly-cyclic-conv",
    "body": [
      "inline vector<long long> cyclic_scalar_product(const vector<long long> &a, const vector<long long> &b) {",
      "    int n = a.size();",
      "    assert((int)b.size() == n);",
      "    vector<long long> ra(n);",
      "    for (int i = 0; i < n; i++) ra[i] = a[n - 1 - i];",
      "    vector<long long> b_dup = b;",
      "    b_dup.insert(b_dup.end(), b.begin(), b.end());",
      "    auto conv = multiply_fft(ra, b_dup);",
      "    vector<long long> res(n);",
      "    for (int s = 0; s < n; s++) res[s] = conv[n - 1 + s];",
      "    return res;",
      "}"
    ],
    "description": "Computes dot products with all cyclic shifts in O(n log n) via polynomial multiplication."
  },
  "Attaching Cyclic Binary Stripes (Conflict Avoidance)": {
    "prefix": "cp-poly-binary-stripes",
    "body": [
      "// Returns all valid cyclic shift offsets s where no index has 1 in both arrays",
      "inline vector<int> find_zero_conflict_shifts(const vector<long long> &a, const vector<long long> &b) {",
      "    auto conflicts = cyclic_scalar_product(a, b);",
      "    vector<int> valid_shifts;",
      "    for (int s = 0; s < (int)conflicts.size(); s++) {",
      "        if (conflicts[s] == 0) valid_shifts.push_back(s);",
      "    }",
      "    return valid_shifts;",
      "}"
    ],
    "description": "Finds all zero-conflict cyclic shift alignments for binary sequences in O(n log n)."
  },
  "String Matching with Wildcards using FFT": {
    "prefix": "cp-poly-wildcard-match",
    "body": [
      "// Returns 0-based start indices of all occurrences of pat in text (supporting wildcard '?')",
      "inline vector<int> string_matching_wildcard(const string &text, const string &pat, char wildcard = '?') {",
      "    int n = text.size(), m = pat.size();",
      "    if (m > n) return {};",
      "",
      "    auto val = [&](char c) -> long long {",
      "        return (c == wildcard) ? 0LL : (c - 'a' + 1);",
      "    };",
      "",
      "    vector<long long> T(n), P(m);",
      "    for (int i = 0; i < n; i++) T[i] = val(text[i]);",
      "    for (int j = 0; j < m; j++) P[j] = val(pat[m - 1 - j]); // Reverse pattern",
      "",
      "    vector<long long> T3(n), T2(n), T1(n);",
      "    vector<long long> P1(m), P2(m), P3(m);",
      "    for (int i = 0; i < n; i++) {",
      "        T1[i] = T[i];",
      "        T2[i] = T[i] * T[i];",
      "        T3[i] = T2[i] * T[i];",
      "    }",
      "    for (int j = 0; j < m; j++) {",
      "        P1[j] = P[j];",
      "        P2[j] = P[j] * P[j];",
      "        P3[j] = P2[j] * P[j];",
      "    }",
      "",
      "    auto C1 = multiply_fft(T3, P1);",
      "    auto C2 = multiply_fft(T2, P2);",
      "    auto C3 = multiply_fft(T1, P3);",
      "",
      "    vector<int> matches;",
      "    for (int i = 0; i <= n - m; i++) {",
      "        int idx = (m - 1) + i;",
      "        long long total = C1[idx] - 2 * C2[idx] + C3[idx];",
      "        if (total == 0) matches.push_back(i);",
      "    }",
      "    return matches;",
      "}"
    ],
    "description": "Exact pattern matching with wildcard characters using Clifford-Clifford FFT in O((n+m) log(n+m))."
  }
