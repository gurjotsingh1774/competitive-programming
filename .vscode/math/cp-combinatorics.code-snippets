{
  "Binomial Coefficient (Multiplicative Method)": {
    "prefix": "cp-comb-ncr-mult",
    "body": [
      "#include<iostream>",
      "#include<algorithm>",
      "",
      "long long nCr(int n, int r) {",
      "    if (r < 0 || r > n) return 0;",
      "    if (r > n - r) r = n - r; // Symmetry optimization C(n, r) = C(n, n - r)",
      "",
      "    long long res = 1;",
      "    for (int i = 0; i < r; ++i) {",
      "        res = res * (n - i);",
      "        res /= (i + 1);",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Computes nCr = n*(n-1)*...*(n-r+1)/r! iteratively without overflow in O(r) time and O(1) space."
  },
  "Binomial Coefficients (Pascal DP Table)": {
    "prefix": "cp-comb-ncr-pascal",
    "body": [
      "#include<vector>",
      "#include<algorithm>",
      "",
      "std::vector<std::vector<long long>> buildPascalTriangle(int n) {",
      "    std::vector<std::vector<long long>> C(n + 1, std::vector<long long>(n + 1, 0));",
      "    for (int i = 0; i <= n; ++i) {",
      "        C[i][0] = 1;",
      "        for (int j = 1; j <= i; ++j) {",
      "            C[i][j] = C[i - 1][j - 1] + C[i - 1][j];",
      "        }",
      "    }",
      "    return C;",
      "}"
    ],
    "description": "Computes binomial coefficients modulo m for all pairs up to (n, r) using Pascals recurrence in O(n*r)."
  },
  "Factorials and Binomial Coefficients Modulo P": {
    "prefix": "cp-comb-ncr-mod",
    "body": [
      "const long long MOD = 1e9 + 7;",
      "",
      "vector<long long> fact, invFact;",
      "",
      "inline long long power_mod(long long base, long long exp, long long mod = MOD) {",
      "    long long res = 1;",
      "    base %= mod;",
      "    while (exp > 0) {",
      "        if (exp & 1) res = (unsigned __int128)res * base % mod;",
      "        base = (unsigned __int128)base * base % mod;",
      "        exp >>= 1;",
      "    }",
      "    return res;",
      "}",
      "",
      "void precompute_factorials(int n, long long mod = MOD) {",
      "    fact.resize(n + 1);",
      "    invFact.resize(n + 1);",
      "    fact[0] = 1;",
      "    for (int i = 1; i <= n; i++) {",
      "        fact[i] = fact[i - 1] * i % mod;",
      "    }",
      "    invFact[n] = power_mod(fact[n], mod - 2, mod);",
      "    for (int i = n; i >= 1; i--) {",
      "        invFact[i - 1] = invFact[i] * i % mod;",
      "    }",
      "}",
      "",
      "inline long long nCr_mod(int n, int r, long long mod = MOD) {",
      "    if (r < 0 || r > n) return 0;",
      "    return fact[n] * invFact[r] % mod * invFact[n - r] % mod;",
      "}",
      "",
      "inline long long nPr_mod(int n, int r, long long mod = MOD) {",
      "    if (r < 0 || r > n) return 0;",
      "    return fact[n] * invFact[n - r] % mod;",
      "}"
    ],
    "description": "Precomputes factorial and inverse-factorial tables up to N in O(N) time for O(1) nCr queries modulo prime p."
  },
  "Combinatorics Lookup Table (Comb Struct)": {
    "prefix": "cp-comb-table",
    "body": [
      "struct Comb {",
      "    vector<mint> f, fi;",
      "    Comb(int n = 1) : f(1, 1), fi(1, 1) { grow(n); }",
      "    void grow(int n) {",
      "        int old = f.size();",
      "        if (n < old) return;",
      "        f.resize(n + 1), fi.resize(n + 1);",
      "        for (int i = old; i <= n; i++) f[i] = f[i - 1] * i;",
      "        fi[n] = f[n].inv();",
      "        for (int i = n; i > old; i--) fi[i - 1] = fi[i] * i;",
      "    }",
      "    mint C(int n, int r) { if (n < 0 || r < 0 || r > n) return 0; grow(n); return f[n] * fi[r] * fi[n - r]; }",
      "    mint P(int n, int r) { if (n < 0 || r < 0 || r > n) return 0; grow(n); return f[n] * fi[n - r]; }",
      "    mint inv(int i) { grow(i); return fi[i] * f[i - 1]; }",
      "    mint catalan(int n) { return C(2 * n, n) - C(2 * n, n + 1); }",
      "    mint stars_and_bars(int n, int k) { return k == 0 ? mint(n == 0) : C(n + k - 1, k - 1); }",
      "};"
    ],
    "description": "Maintains factorials and inverse factorials, dynamically resizing for O(1) nCr, nPr, and Catalan queries."
  },
  "Lucas Theorem": {
    "prefix": "cp-comb-lucas",
    "body": [
      "inline ll lucas(ll n, ll r, ll p) {",
      "    if (r < 0 || r > n) return 0;",
      "    vector<ll> f(p, 1), fi(p, 1);",
      "    for (ll i = 1; i < p; i++) f[i] = f[i - 1] * i % p;",
      "    fi[p - 1] = power_mod(f[p - 1], p - 2, p);",
      "    for (ll i = p - 1; i > 0; i--) fi[i - 1] = fi[i] * i % p;",
      "    ll res = 1;",
      "    while (n || r) {",
      "        ll a = n % p, b = r % p;",
      "        if (b > a) return 0;",
      "        res = res * f[a] % p * fi[b] % p * fi[a - b] % p;",
      "        n /= p, r /= p;",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Computes nCr modulo a small prime p in O(p + log_p n) time using Lucas theorem."
  },
  "Catalan Numbers (Dynamic Programming)": {
    "prefix": "cp-comb-catalan-dp",
    "body": [
      "#include<vector>",
      "",
      "long long catalanDP(int n) {",
      "    std::vector<long long> C(n + 1, 0);",
      "    C[0] = 1;",
      "    if (n >= 1) C[1] = 1;",
      "",
      "    for (int i = 2; i <= n; ++i) {",
      "        for (int j = 0; j < i; ++j) {",
      "            C[i] += C[j] * C[i - 1 - j];",
      "        }",
      "    }",
      "    return C[n];",
      "}"
    ],
    "description": "Computes Catalan numbers C_0 through C_n using the convolution recurrence in O(n^2) time."
  },
  "Catalan Numbers (Direct Formula)": {
    "prefix": "cp-comb-catalan-formula",
    "body": [
      "long long catalanFormula(int n) {",
      "    if (n <= 1) return 1;",
      "    long long res = 1;",
      "    // C_n = prod_{k=2}^n (n + k) / k",
      "    for (int k = 2; k <= n; ++k) {",
      "        res = (res * (n + k)) / k;",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Computes C_n = 1/(n+1) * (2n choose n) using factorials or multiplicative nCr."
  },
  "Generate Combinations (Unique Subsets)": {
    "prefix": "cp-comb-unique",
    "body": [
      "#include<vector>",
      "#include<algorithm>",
      "",
      "void generateCombinations(const std::vector<int>& arr, int start,",
      "                          std::vector<int>& current,",
      "                          std::vector<std::vector<int>>& result) {",
      "    if (!current.empty()) {",
      "        result.push_back(current);",
      "    }",
      "",
      "    for (size_t i = start; i < arr.size(); ++i) {",
      "        // Skip identical adjacent elements at the current depth to avoid duplicate combinations",
      "        if (i > static_cast<size_t>(start) && arr[i] == arr[i - 1]) continue;",
      "",
      "        current.push_back(arr[i]);",
      "        generateCombinations(arr, i + 1, current, result);",
      "        current.pop_back(); // Backtrack",
      "    }",
      "}",
      "",
      "std::vector<std::vector<int>> getCombinations(std::vector<int> arr) {",
      "    std::sort(arr.begin(), arr.end());",
      "    std::vector<std::vector<int>> result;",
      "    std::vector<int> current;",
      "    generateCombinations(arr, 0, current, result);",
      "    return result;",
      "}"
    ],
    "description": "Generates all unique combinations of size k from elements with duplicates via backtracking."
  },
  "Generate Combinations with Repetition (Multiset)": {
    "prefix": "cp-comb-multiset",
    "body": [
      "#include<vector>",
      "",
      "void generateCombinationsWithRepetition(const std::vector<int>& arr, int start, int k,",
      "                                       std::vector<int>& current,",
      "                                       std::vector<std::vector<int>>& result) {",
      "    if (static_cast<int>(current.size()) == k) {",
      "        result.push_back(current);",
      "        return;",
      "    }",
      "",
      "    for (size_t i = start; i < arr.size(); ++i) {",
      "        current.push_back(arr[i]);",
      "        // Recurse with `i` (not `i + 1`) to allow repeated usage of arr[i]",
      "        generateCombinationsWithRepetition(arr, i, k, current, result);",
      "        current.pop_back(); // Backtrack",
      "    }",
      "}"
    ],
    "description": "Generates combinations of size k where each element can be selected multiple times."
  },
  "Generate Permutations (Unique Permutations)": {
    "prefix": "cp-comb-permutations-unique",
    "body": [
      "#include<vector>",
      "#include<algorithm>",
      "#include<set>",
      "",
      "void backtrackPermutations(std::vector<int>& nums, int start, std::set<std::vector<int>>& results) {",
      "    if (start == static_cast<int>(nums.size()) - 1) {",
      "        results.insert(nums);",
      "        return;",
      "    }",
      "",
      "    for (size_t i = start; i < nums.size(); ++i) {",
      "        if (i > static_cast<size_t>(start) && nums[i] == nums[start]) continue;",
      "",
      "        std::swap(nums[start], nums[i]);",
      "        backtrackPermutations(nums, start + 1, results);",
      "        std::swap(nums[start], nums[i]); // Backtrack",
      "    }",
      "}"
    ],
    "description": "Generates all unique permutations of a sequence containing duplicate values via backtracking."
  },
  "Next Lexicographical Permutation": {
    "prefix": "cp-comb-next-permutation",
    "body": [
      "#include<vector>",
      "#include<algorithm>",
      "",
      "bool nextPermutation(std::vector<int>& nums) {",
      "    int n = nums.size();",
      "    int i = n - 2;",
      "",
      "    // Step 1: Find first ascending pair from the right",
      "    while (i >= 0 && nums[i] >= nums[i + 1]) {",
      "        --i;",
      "    }",
      "",
      "    if (i < 0) {",
      "        // Entire sequence is descending; reverse to wrap around to sorted order",
      "        std::reverse(nums.begin(), nums.end());",
      "        return false; // Last permutation reached",
      "    }",
      "",
      "    // Step 2: Find rightmost element greater than nums[i]",
      "    int j = n - 1;",
      "    while (nums[j] <= nums[i]) {",
      "        --j;",
      "    }",
      "",
      "    // Step 3: Swap pivot with successor",
      "    std::swap(nums[i], nums[j]);",
      "",
      "    // Step 4: Reverse suffix to minimize lexicographical order",
      "    std::reverse(nums.begin() + i + 1, nums.end());",
      "    return true;",
      "}"
    ],
    "description": "In-place algorithm equivalent to std::next_permutation in O(n) time and O(1) auxiliary space."
  },
  "Traverse Permutations (STL)": {
