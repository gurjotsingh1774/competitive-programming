  "Catalan Convolution (k-fold Convolution & Prefix Completion)": {
    "prefix": "cp-comb-catalan-convolution",
    "body": [
      "#include <vector>",
      "#include <string>",
      "",
      "// 1. Evaluates C^{(k)}_n = (k + 1) / (n + k + 1) * C(2n + k, n) mod MOD",
      "// Represents sum_{a_0 + ... + a_k = n} C_{a_0} * ... * C_{a_k} in O(1) query",
      "long long catalanConvolution(long long n, long long k, const auto& nCr, long long mod = 1000000007) {",
      "    if (n < 0 || k < 0) return 0;",
      "    if (n == 0) return 1;",
      "    // C^{(k)}_n = C(2n + k, n) - C(2n + k, n - 1)",
      "    long long ans = (nCr(2 * n + k, n) - nCr(2 * n + k, n - 1) + mod) % mod;",
      "    return ans;",
      "}",
      "",
      "// 2. Linear recurrence for table precomputation: C^{(k)}_n = (2n + k - 1)(2n + k) / (n(n + k + 1)) * C^{(k)}_{n-1}",
      "std::vector<long long> buildCatalanConvolutionRow(int max_n, long long k, const auto& inv, long long mod = 1000000007) {",
      "    std::vector<long long> C(max_n + 1, 0);",
      "    C[0] = 1;",
      "    for (int n = 1; n <= max_n; ++n) {",
      "        long long num = (2LL * n + k - 1) % mod * ((2LL * n + k) % mod) % mod;",
      "        long long den = (long long)n * ((n + k + 1) % mod) % mod;",
      "        C[n] = C[n - 1] * num % mod * inv(den) % mod;",
      "    }",
      "    return C;",
      "}",
      "",
      "// 3. CSES Bracket Sequences II: Given prefix, find number of valid balanced sequences of 2*n total brackets",
      "long long completeBracketSequence(int n, const std::string& prefix, const auto& nCr, long long mod = 1000000007) {",
      "    int open = 0, close = 0;",
      "    for (char c : prefix) {",
      "        if (c == '(') open++;",
      "        else close++;",
      "        if (close > open || open > n) return 0; // Invalid prefix: dipped below zero or too many open",
      "    }",
      "    int k = open - close;      // Excess open brackets",
      "    int rem = n - open;        // Remaining open brackets to place",
      "    return catalanConvolution(rem, k, nCr, mod);",
      "}"
    ],
    "description": "Calculates the k-th Catalan convolution C^{(k)}_n = sum_{a_0+...+a_k=n} C_{a_0}...C_{a_k} in O(1) query, and solves bracket sequence completions."
  },
  "Inclusion-Exclusion Principle and Binomial Inversion": {
    "prefix": "cp-comb-pie",
    "body": [
      "#include <vector>",
      "",
      "// 1. Bitmask PIE: Count integers in [1, n] coprime to given set of primes",
      "long long countCoprime(long long n, const std::vector<long long>& primes) {",
      "    int k = primes.size();",
      "    long long count = 0;",
      "    for (int mask = 1; mask < (1 << k); ++mask) {",
      "        long long prod = 1;",
      "        int bits = 0;",
      "        for (int i = 0; i < k; ++i) {",
      "            if (mask & (1 << i)) {",
      "                prod *= primes[i];",
      "                ++bits;",
      "                if (prod > n) break;",
      "            }",
      "        }",
      "        if (prod > n) continue;",
      "        if (bits & 1) count += n / prod;",
      "        else count -= n / prod;",
      "    }",
      "    return n - count;",
      "}",
      "",
      "// 2. Binomial Inversion: E[k] (exactly k properties) from L[j] (at least j properties)",
      "// E[k] = sum_{j=k}^n (-1)^(j - k) * C(j, k) * L[j]",
      "std::vector<long long> exactFromAtLeast(const std::vector<long long>& L, const std::vector<std::vector<long long>>& C, long long mod) {",
      "    int n = L.size() - 1;",
      "    std::vector<long long> E(n + 1, 0);",
      "    for (int k = 0; k <= n; ++k) {",
      "        long long sum = 0;",
      "        for (int j = k; j <= n; ++j) {",
      "            long long term = C[j][k] * (L[j] % mod) % mod;",
      "            if ((j - k) % 2 == 1) sum = (sum - term + mod) % mod;",
      "            else sum = (sum + term) % mod;",
      "        }",
      "        E[k] = sum;",
      "    }",
      "    return E;",
      "}"
    ],
    "description": "Principle of Inclusion-Exclusion bitmask template and Binomial Inversion (calculating exact k from at least k)."
  },
  "Derangements (Count and Array Generation)": {
    "prefix": "cp-comb-derangements",
    "body": [
      "#include <vector>",
      "#include <algorithm>",
      "",
      "// 1. Precompute Derangements modulo mod: D[n] = (n - 1) * (D[n-1] + D[n-2])",
      "std::vector<long long> computeDerangements(int n, long long mod = 1000000007) {",
      "    std::vector<long long> D(n + 1, 0);",
      "    D[0] = 1;",
      "    if (n >= 1) D[1] = 0;",
      "    for (int i = 2; i <= n; ++i) {",
      "        D[i] = (i - 1LL) * (D[i - 1] + D[i - 2]) % mod;",
      "    }",
      "    return D;",
      "}",
      "",
      "// 2. Constructive Derangement of Array with Duplicates (CF 66176)",
      "// Returns empty vector if impossible (max frequency > n / 2)",
      "std::vector<int> generateArrayDerangement(const std::vector<int>& a) {",
      "    int n = a.size();",
      "    std::vector<std::pair<int, int>> sorted(n);",
      "    for (int i = 0; i < n; ++i) sorted[i] = {a[i], i};",
      "    std::sort(sorted.begin(), sorted.end());",
      "    int max_freq = 0, cur_freq = 0;",
      "    for (int i = 0; i < n; ++i) {",
      "        if (i > 0 && sorted[i].first == sorted[i - 1].first) ++cur_freq;",
      "        else cur_freq = 1;",
      "        max_freq = std::max(max_freq, cur_freq);",
      "    }",
      "    if (max_freq > n / 2) return {}; // Derangement impossible",
      "    std::vector<int> res(n);",
      "    int shift = n / 2;",
      "    for (int i = 0; i < n; ++i) {",
      "        int orig_idx = sorted[i].second;",
      "        int target_val = sorted[(i + shift) % n].first;",
      "        res[orig_idx] = target_val;",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Precomputes derangements D[n] modulo m and generates derangements of arrays with duplicates in O(n log n)."
  },
  "Divisor Inclusion-Exclusion DP (Multiples DP)": {
    "prefix": "cp-comb-divisor-pie",
    "body": [
      "#include <vector>",
      "#include <algorithm>",
      "",
      "// Backwards multiple DP / Divisor PIE: count pairs (i, j) with gcd(a[i], a[j]) == g in O(M log M)",
      "std::vector<long long> countPairsByGcd(const std::vector<int>& a) {",
      "    if (a.empty()) return {};",
      "    int m = *std::max_element(a.begin(), a.end());",
      "    std::vector<int> cnt(m + 1, 0);",
      "    for (int x : a) cnt[x]++;",
      "    std::vector<long long> multiples(m + 1, 0);",
      "    for (int i = 1; i <= m; ++i) {",
      "        for (int j = i; j <= m; j += i) multiples[i] += cnt[j];",
      "    }",
      "    // dp[g] = count of pairs with exact gcd g",
      "    std::vector<long long> dp(m + 1, 0);",
      "    for (int g = m; g >= 1; --g) {",
      "        dp[g] = multiples[g] * (multiples[g] - 1LL) / 2;",
      "        for (int k = 2 * g; k <= m; k += g) {",
      "            dp[g] -= dp[k];",
      "        }",
      "    }",
      "    return dp;",
      "}"
    ],
    "description": "Divisor Inclusion-Exclusion DP: counts pairs with exact gcd g via backwards multiple transitions in O(M log M) without Moebius."
  },
  "Contribution Technique (Subarrays and Subsets)": {
    "prefix": "cp-comb-contribution",
    "body": [
      "#include <vector>",
      "#include <stack>",
      "#include <algorithm>",
      "",
      "// 1. Subarray Sum Contribution: each element a[i] contributes to (i + 1) * (n - i) subarrays",
      "long long sumAllSubarrays(const std::vector<long long>& a) {",
      "    int n = a.size();",
      "    long long total = 0;",
      "    for (int i = 0; i < n; ++i) {",
      "        total += a[i] * (i + 1LL) * (n - i);",
      "    }",
      "    return total;",
      "}",
      "",
      "// 2. Subarray Minimums Sum: O(n) using monotonic stack (Previous Less, Next Less or Equal)",
      "long long sumSubarrayMins(const std::vector<long long>& a) {",
      "    int n = a.size();",
      "    std::vector<int> ple(n), nle(n);",
      "    std::stack<int> st;",
      "    for (int i = 0; i < n; ++i) {",
      "        while (!st.empty() && a[st.top()] >= a[i]) st.pop();",
      "        ple[i] = st.empty() ? -1 : st.top();",
      "        st.push(i);",
      "    }",
      "    while (!st.empty()) st.pop();",
      "    for (int i = n - 1; i >= 0; --i) {",
      "        while (!st.empty() && a[st.top()] > a[i]) st.pop();",
      "        nle[i] = st.empty() ? n : st.top();",
      "        st.push(i);",
      "    }",
      "    long long total = 0;",
      "    for (int i = 0; i < n; ++i) {",
      "        total += a[i] * (long long)(i - ple[i]) * (nle[i] - i);",
      "    }",
      "    return total;",
      "}",
      "",
      "// 3. Subarray Maximums Sum: O(n) using monotonic stack (Previous Greater, Next Greater or Equal)",
      "long long sumSubarrayMaxs(const std::vector<long long>& a) {",
      "    int n = a.size();",
      "    std::vector<int> pge(n), nge(n);",
      "    std::stack<int> st;",
      "    for (int i = 0; i < n; ++i) {",
      "        while (!st.empty() && a[st.top()] <= a[i]) st.pop();",
      "        pge[i] = st.empty() ? -1 : st.top();",
      "        st.push(i);",
      "    }",
      "    while (!st.empty()) st.pop();",
      "    for (int i = n - 1; i >= 0; --i) {",
      "        while (!st.empty() && a[st.top()] < a[i]) st.pop();",
      "        nge[i] = st.empty() ? n : st.top();",
      "        st.push(i);",
      "    }",
      "    long long total = 0;",
      "    for (int i = 0; i < n; ++i) {",
      "        total += a[i] * (long long)(i - pge[i]) * (nge[i] - i);",
      "    }",
      "    return total;",
      "}",
      "",
      "// 4. Subset Range Sum: sum of (max(S) - min(S)) over all subsets in O(n log n)",
      "long long sumSubsetRanges(std::vector<long long> a, long long mod = 1000000007) {",
      "    int n = a.size();",
      "    std::sort(a.begin(), a.end());",
      "    std::vector<long long> p2(n, 1);",
      "    for (int i = 1; i < n; ++i) p2[i] = (p2[i - 1] * 2) % mod;",
      "    long long total = 0;",
      "    for (int i = 0; i < n; ++i) {",
      "        long long ways = (p2[i] - p2[n - 1 - i] + mod) % mod;",
      "        total = (total + (a[i] % mod + mod) % mod * ways) % mod;",
      "    }",
      "    return total;",
      "}"
    ],
    "description": "Computes element contributions to subarray sums, subarray minimums/maximums via monotonic stack in O(n), and subset ranges in O(n log n)."
  },
  "Product Trick (Combinatorial Rephrasing DP)": {
    "prefix": "cp-comb-product-trick",
    "body": [
      "#include <vector>",
      "",
      "// Product Trick: rephrase prod(a_i) as choosing exactly one marked (colored) element per group/box.",
      "// Example 1: Sum of prod(segment lengths) over all valid partitions in O(n) linear DP.",
      "long long sumProdPartitionLengths(int n, long long mod = 1000000007) {",
      "    // dp[0]: current segment does NOT have a marked element",
      "    // dp[1]: current segment ALREADY HAS a marked element",
      "    long long dp0 = 1, dp1 = 0;",
      "    for (int i = 1; i <= n; ++i) {",
      "        // 1. Element i can be unmarked: dp0 stays dp0, dp1 stays dp1",
      "        // 2. Element i can be the marked element: dp1 += dp0",
      "        long long next_dp0 = dp0;",
      "        long long next_dp1 = (dp1 + dp0) % mod;",
      "        // 3. Segment can close if it has a marked element, starting a new segment",
      "        next_dp0 = (next_dp0 + next_dp1) % mod;",
      "        dp0 = next_dp0;",
      "        dp1 = next_dp1;",
      "    }",
      "    return dp1; // Final valid partitions where last segment has a marked element",
      "}",
      "",
      "// Example 2: Product of box counts under k operations in O(n^2) (TheScrasse CF 98624)",
      "// dp[i][j] = ways to pick red balls from initial A[i] items across first i boxes, choosing in j boxes.",
      "// dp[i][j] = dp[i - 1][j] + A[i] * dp[i - 1][j - 1]",
      "std::vector<std::vector<long long>> productTrickInitialDP(const std::vector<long long>& A, long long mod = 1000000007) {",
      "    int n = A.size();",
      "    std::vector<std::vector<long long>> dp(n + 1, std::vector<long long>(n + 1, 0));",
      "    dp[0][0] = 1;",
      "    for (int i = 1; i <= n; ++i) {",
      "        for (int j = 0; j <= i; ++j) {",
      "            dp[i][j] = dp[i - 1][j];",
      "            if (j > 0) {",
      "                dp[i][j] = (dp[i][j] + (A[i - 1] % mod) * dp[i - 1][j - 1]) % mod;",
      "            }",
      "        }",
      "    }",
      "    return dp;",
      "}"
    ],
    "description": "Product Trick: rephrases product of sizes/counts into choosing one marked element per group, collapsing DP states into O(n) or O(n^2)."
  },
  "Binomial Coefficients Range Sum (Mo's Algorithm)": {
    "prefix": "cp-comb-sum-mo",
    "body": [
      "#include <vector>",
      "#include <cmath>",
      "#include <algorithm>",
      "",
      "// Offline range sum queries: sum_{i=l}^r C(n, i) mod MOD in O((N + Q) * sqrt(N)) via Mo's on combinations",
      "struct BinomialRangeQuery {",
      "    int l, r, n, id;",
      "};",
      "std::vector<long long> rangeSumBinomial(int max_n, const std::vector<BinomialRangeQuery>& queries, long long mod = 1000000007) {",
      "    int q = queries.size();",
      "    if (q == 0) return {};",
      "    std::vector<long long> fact(max_n + 1, 1), invFact(max_n + 1, 1);",
      "    auto power = [&](long long b, long long e) {",
      "        long long r = 1; b %= mod;",
      "        while (e) { if (e & 1) r = r * b % mod; b = b * b % mod; e >>= 1; }",
      "        return r;",
      "    };",
      "    for (int i = 1; i <= max_n; ++i) fact[i] = fact[i - 1] * i % mod;",
      "    invFact[max_n] = power(fact[max_n], mod - 2);",
      "    for (int i = max_n; i >= 1; --i) invFact[i - 1] = invFact[i] * i % mod;",
      "    auto C = [&](int n, int r) -> long long {",
      "        if (r < 0 || r > n) return 0;",
      "        return fact[n] * invFact[r] % mod * invFact[n - r] % mod;",
      "    };",
      "    long long inv2 = power(2, mod - 2);",
      "    int B = std::max(1, (int)(max_n / std::max(1.0, std::sqrt(q))));",
      "    std::vector<BinomialRangeQuery> qs = queries;",
      "    std::sort(qs.begin(), qs.end(), [&](const BinomialRangeQuery& a, const BinomialRangeQuery& b) {",
      "        int b1 = a.n / B, b2 = b.n / B;",
      "        if (b1 != b2) return b1 < b2;",
      "        return (b1 & 1) ? a.r < b.r : a.r > b.r;",
      "    });",
      "    std::vector<long long> ans(q);",
      "    int cur_l = 0, cur_r = 0, cur_n = 0;",
      "    long long cur_sum = 1; // sum_{i=0}^0 C(0, i) = 1",
      "    for (const auto& qry : qs) {",
      "        while (cur_n < qry.n) {",
      "            cur_sum = (2 * cur_sum - C(cur_n, cur_l - 1) + C(cur_n, cur_r)) % mod;",
      "            cur_n++;",
      "        }",
      "        while (cur_n > qry.n) {",
      "            cur_sum = (cur_sum + C(cur_n - 1, cur_l - 1) - C(cur_n - 1, cur_r)) % mod;",
      "            cur_sum = cur_sum * inv2 % mod;",
      "            cur_n--;",
      "        }",
      "        while (cur_r < qry.r) { cur_r++; cur_sum = (cur_sum + C(cur_n, cur_r)) % mod; }",
      "        while (cur_r > qry.r) { cur_sum = (cur_sum - C(cur_n, cur_r)) % mod; cur_r--; }",
      "        while (cur_l < qry.l) { cur_sum = (cur_sum - C(cur_n, cur_l)) % mod; cur_l++; }",
      "        while (cur_l > qry.l) { cur_l--; cur_sum = (cur_sum + C(cur_n, cur_l)) % mod; }",
      "        ans[qry.id] = (cur_sum % mod + mod) % mod;",
      "    }",
      "    return ans;",
      "}"
    ],
    "description": "Answers Q offline range sum queries sum_{i=l}^r C(n, i) mod p in O((N + Q) * sqrt(N)) using Mo's algorithm."
  },
  "Sum of Binomial Coefficients Over Congruence Class": {
    "prefix": "cp-comb-sum-congruence",
    "body": [
      "#include <vector>",
      "",
      "// Computes sum_{k=0..n, k % m == r} C(n, k) mod MOD via polynomial power (1 + x)^n mod (x^m - 1)",
      "// Complexity: O(m^2 * log n) cyclic polynomial exponentiation",
      "std::vector<long long> sumBinomialCongruence(long long n, int m, long long mod = 998244353) {",
      "    auto multiply_cyclic = [&](const std::vector<long long>& a, const std::vector<long long>& b) {",
      "        std::vector<long long> c(m, 0);",
      "        for (int i = 0; i < m; ++i) {",
      "            if (!a[i]) continue;",
      "            for (int j = 0; j < m; ++j) {",
      "                int rem = (i + j) % m;",
      "                c[rem] = (c[rem] + a[i] * b[j]) % mod;",
      "            }",
      "        }",
      "        return c;",
      "    };",
      "    std::vector<long long> base(m, 0);",
      "    base[0] = 1; base[1 % m] = (base[1 % m] + 1) % mod; // (1 + x)",
      "    std::vector<long long> res(m, 0);",
      "    res[0] = 1;",
      "    while (n > 0) {",
      "        if (n & 1) res = multiply_cyclic(res, base);",
      "        base = multiply_cyclic(base, base);",
      "        n >>= 1;",
      "    }",
      "    return res; // res[r] = sum_{k=0..n, k % m == r} C(n, k) mod mod",
      "}"
    ],
    "description": "Calculates sum of C(n, k) over k = r mod m in O(m^2 log n) using cyclic polynomial exponentiation mod (x^m - 1)."
  },
  "Sum of nCr(a[i], k) for All k (NTT Convolution)": {
