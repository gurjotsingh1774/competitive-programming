      "",
      "// Computes sum_{i=1..N} C(a[i], k) for all k in [0, max_k] in O(M log M) via frequency cross-correlation",
      "std::vector<long long> sumBinomialArray(const std::vector<int>& a, int max_k, long long mod = 998244353) {",
      "    if (a.empty()) return std::vector<long long>(max_k + 1, 0);",
      "    int m = *std::max_element(a.begin(), a.end());",
      "    std::vector<int> cnt(m + 1, 0);",
      "    for (int x : a) cnt[x]++;",
      "    std::vector<long long> fact(m + 1, 1), invFact(m + 1, 1);",
      "    auto power = [&](long long b, long long e) {",
