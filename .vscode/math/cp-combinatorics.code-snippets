{
  "Binomial Coefficient (Multiplicative Method)": {
    "prefix": "cp-comb-ncr-mult",
    "body": [
      "#include<iostream>",
      "#include<algorithm>",
      "",
      "long long nCr(int n, int r) {",
      "    if (r < 0 || r > n) return 0;",
      "    if (r > n - r) r = n - r; // Symmetry optimization C(n, r) = C(n, n - r)",
      "",
      "    long long res = 1;",
      "    for (int i = 0; i < r; ++i) {",
      "        res = res * (n - i);",
      "        res /= (i + 1);",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Computes nCr = n*(n-1)*...*(n-r+1)/r! iteratively without overflow in O(r) time and O(1) space."
  },
  "Binomial Coefficients (Pascal DP Table)": {
    "prefix": "cp-comb-ncr-pascal",
    "body": [
      "#include<vector>",
      "#include<algorithm>",
      "",
      "std::vector<std::vector<long long>> buildPascalTriangle(int n) {",
      "    std::vector<std::vector<long long>> C(n + 1, std::vector<long long>(n + 1, 0));",
      "    for (int i = 0; i <= n; ++i) {",
      "        C[i][0] = 1;",
      "        for (int j = 1; j <= i; ++j) {",
      "            C[i][j] = C[i - 1][j - 1] + C[i - 1][j];",
      "        }",
      "    }",
      "    return C;",
      "}"
    ],
    "description": "Computes binomial coefficients modulo m for all pairs up to (n, r) using Pascals recurrence in O(n*r)."
  },
  "Factorials and Binomial Coefficients Modulo P": {
    "prefix": "cp-comb-ncr-mod",
    "body": [
      "const long long MOD = 1e9 + 7;",
      "",
      "vector<long long> fact, invFact;",
      "",
      "inline long long power_mod(long long base, long long exp, long long mod = MOD) {",
      "    long long res = 1;",
      "    base %= mod;",
      "    while (exp > 0) {",
      "        if (exp & 1) res = (unsigned __int128)res * base % mod;",
      "        base = (unsigned __int128)base * base % mod;",
      "        exp >>= 1;",
      "    }",
      "    return res;",
      "}",
      "",
      "void precompute_factorials(int n, long long mod = MOD) {",
      "    fact.resize(n + 1);",
      "    invFact.resize(n + 1);",
      "    fact[0] = 1;",
      "    for (int i = 1; i <= n; i++) {",
      "        fact[i] = fact[i - 1] * i % mod;",
      "    }",
      "    invFact[n] = power_mod(fact[n], mod - 2, mod);",
      "    for (int i = n; i >= 1; i--) {",
      "        invFact[i - 1] = invFact[i] * i % mod;",
      "    }",
      "}",
      "",
      "inline long long nCr_mod(int n, int r, long long mod = MOD) {",
      "    if (r < 0 || r > n) return 0;",
      "    return fact[n] * invFact[r] % mod * invFact[n - r] % mod;",
      "}",
      "",
      "inline long long nPr_mod(int n, int r, long long mod = MOD) {",
      "    if (r < 0 || r > n) return 0;",
      "    return fact[n] * invFact[n - r] % mod;",
      "}"
    ],
    "description": "Precomputes factorial and inverse-factorial tables up to N in O(N) time for O(1) nCr queries modulo prime p."
  },
  "Combinatorics Lookup Table (Comb Struct)": {
    "prefix": "cp-comb-table",
    "body": [
      "struct Comb {",
      "    vector<mint> f, fi;",
      "    Comb(int n = 1) : f(1, 1), fi(1, 1) { grow(n); }",
      "    void grow(int n) {",
      "        int old = f.size();",
      "        if (n < old) return;",
      "        f.resize(n + 1), fi.resize(n + 1);",
      "        for (int i = old; i <= n; i++) f[i] = f[i - 1] * i;",
      "        fi[n] = f[n].inv();",
      "        for (int i = n; i > old; i--) fi[i - 1] = fi[i] * i;",
      "    }",
      "    mint C(int n, int r) { if (n < 0 || r < 0 || r > n) return 0; grow(n); return f[n] * fi[r] * fi[n - r]; }",
      "    mint P(int n, int r) { if (n < 0 || r < 0 || r > n) return 0; grow(n); return f[n] * fi[n - r]; }",
      "    mint inv(int i) { grow(i); return fi[i] * f[i - 1]; }",
      "    mint catalan(int n) { return C(2 * n, n) - C(2 * n, n + 1); }",
      "    mint stars_and_bars(int n, int k) { return k == 0 ? mint(n == 0) : C(n + k - 1, k - 1); }",
      "};"
    ],
    "description": "Maintains factorials and inverse factorials, dynamically resizing for O(1) nCr, nPr, and Catalan queries."
  },
  "Lucas Theorem": {
    "prefix": "cp-comb-lucas",
    "body": [
      "inline ll lucas(ll n, ll r, ll p) {",
      "    if (r < 0 || r > n) return 0;",
      "    vector<ll> f(p, 1), fi(p, 1);",
      "    for (ll i = 1; i < p; i++) f[i] = f[i - 1] * i % p;",
      "    fi[p - 1] = power_mod(f[p - 1], p - 2, p);",
      "    for (ll i = p - 1; i > 0; i--) fi[i - 1] = fi[i] * i % p;",
      "    ll res = 1;",
      "    while (n || r) {",
      "        ll a = n % p, b = r % p;",
      "        if (b > a) return 0;",
      "        res = res * f[a] % p * fi[b] % p * fi[a - b] % p;",
      "        n /= p, r /= p;",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "Computes nCr modulo a small prime p in O(p + log_p n) time using Lucas theorem."
  },
  "Legendre's Formula (Factorial Prime Multiplicity)": {
    "prefix": "cp-comb-legendre",
    "body": [
      "// Legendre's formula: highest power of prime p dividing n! (v_p(n!)) in O(log_p n)",
      "long long legendre(long long n, long long p) {",
      "    long long count = 0;",
      "    while (n > 0) {",
      "        count += n / p;",
      "        n /= p;",
      "    }",
      "    return count;",
      "}",
      "",
      "// Highest power of prime p dividing nCr: v_p(C(n, r)) = v_p(n!) - v_p(r!) - v_p((n-r)!)",
      "long long primeValuationnCr(long long n, long long r, long long p) {",
      "    if (r < 0 || r > n) return 0;",
      "    return legendre(n, p) - legendre(r, p) - legendre(n - r, p);",
      "}"
    ],
    "description": "Computes the highest power of prime p dividing n! (Legendre formula) and nCr in O(log_p n) time."
  },
  "Binomial Coefficient Modulo Arbitrary Modulus (Granville & CRT)": {
    "prefix": "cp-comb-ncr-arbitrary",
    "body": [
      "#include <vector>",
      "",
      "// Computes nCr modulo arbitrary composite m (Prime-Power Granville + Chinese Remainder Theorem)",
      "long long extgcd(long long a, long long b, long long &x, long long &y) {",
      "    if (!b) { x = 1; y = 0; return a; }",
      "    long long g = extgcd(b, a % b, y, x);",
      "    y -= a / b * x;",
      "    return g;",
      "}",
      "long long modInverse(long long a, long long m) {",
      "    long long x, y;",
      "    extgcd(a, m, x, y);",
      "    return (x % m + m) % m;",
      "}",
      "long long power_mod(long long base, long long exp, long long mod) {",
      "    long long res = 1; base %= mod;",
      "    while (exp > 0) {",
      "        if (exp & 1) res = (unsigned __int128)res * base % mod;",
      "        base = (unsigned __int128)base * base % mod;",
      "        exp >>= 1;",
      "    }",
      "    return res;",
      "}",
      "long long fact_p_free(long long n, long long p, long long pa, const std::vector<long long>& pref) {",
      "    if (n == 0) return 1;",
      "    long long res = power_mod(pref[pa], n / pa, pa) * pref[n % pa] % pa;",
      "    return res * fact_p_free(n / p, p, pa, pref) % pa;",
      "}",
      "long long nCr_prime_power(long long n, long long r, long long p, long long a) {",
      "    if (r < 0 || r > n) return 0;",
      "    long long pa = 1; for (int i = 0; i < a; ++i) pa *= p;",
      "    long long v = 0;",
      "    for (long long k = n; k; k /= p) v += k / p;",
      "    for (long long k = r; k; k /= p) v -= k / p;",
      "    for (long long k = n - r; k; k /= p) v -= k / p;",
      "    if (v >= a) return 0;",
      "    std::vector<long long> pref(pa + 1, 1);",
      "    for (int i = 1; i <= pa; ++i) {",
      "        pref[i] = pref[i - 1];",
      "        if (i % p != 0) pref[i] = pref[i] * i % pa;",
      "    }",
      "    long long num = fact_p_free(n, p, pa, pref);",
      "    long long den = fact_p_free(r, p, pa, pref) * fact_p_free(n - r, p, pa, pref) % pa;",
      "    long long ans = num * modInverse(den, pa) % pa;",
      "    return ans * power_mod(p, v, pa) % pa;",
      "}",
      "long long nCr_arbitrary(long long n, long long r, long long m) {",
      "    if (r < 0 || r > n) return 0;",
      "    if (m == 1) return 0;",
      "    std::vector<long long> rems, mods;",
      "    long long temp = m;",
      "    for (long long p = 2; p * p <= temp; ++p) {",
      "        if (temp % p == 0) {",
      "            long long a = 0, pa = 1;",
      "            while (temp % p == 0) { temp /= p; ++a; pa *= p; }",
      "            rems.push_back(nCr_prime_power(n, r, p, a));",
      "            mods.push_back(pa);",
      "        }",
      "    }",
      "    if (temp > 1) {",
      "        rems.push_back(nCr_prime_power(n, r, temp, 1));",
      "        mods.push_back(temp);",
      "    }",
      "    long long ans = 0;",
      "    for (size_t i = 0; i < mods.size(); ++i) {",
      "        long long M_i = m / mods[i];",
      "        long long inv = modInverse(M_i, mods[i]);",
      "        ans = (ans + (unsigned __int128)rems[i] * M_i % m * inv) % m;",
      "    }",
      "    return ans;",
      "}"
    ],
    "description": "Computes nCr modulo arbitrary composite m (or prime powers p^a) via Andrew Granville's theorem and CRT."
  },
  "Catalan Numbers (Dynamic Programming)": {
    "prefix": "cp-comb-catalan-dp",
    "body": [
      "#include<vector>",
      "",
      "long long catalanDP(int n) {",
      "    std::vector<long long> C(n + 1, 0);",
      "    C[0] = 1;",
      "    if (n >= 1) C[1] = 1;",
      "",
      "    for (int i = 2; i <= n; ++i) {",
      "        for (int j = 0; j < i; ++j) {",
      "            C[i] += C[j] * C[i - 1 - j];",
      "        }",
      "    }",
      "    return C[n];",
      "}"
    ],
    "description": "Computes Catalan numbers C_0 through C_n using the convolution recurrence in O(n^2) time."
  },
  "Catalan Numbers (Direct Formula)": {
    "prefix": "cp-comb-catalan-formula",
    "body": [
      "long long catalanFormula(int n) {",
      "    if (n <= 1) return 1;",
      "    long long res = 1;",
      "    // C_n = prod_{k=2}^n (n + k) / k",
