{
  "Linear Sieve for Totient and M\u00f6bius (Phi & Mu)": {
    "prefix": "cp-mobius-linear-sieve",
    "body": [
      "// Euler's Linear Sieve: computes phi and mu for all 1 <= i <= n in strictly O(n)",
      "vector<int> spf, primes, phi, mu;",
      "void sieve_phi_mu(int n) {",
      "    spf.assign(n + 1, 0);",
      "    phi.assign(n + 1, 0);",
      "    mu.assign(n + 1, 0);",
      "    primes.clear();",
      "    phi[1] = mu[1] = 1;",
      "    for (int i = 2; i <= n; i++) {",
      "        if (!spf[i]) {",
      "            spf[i] = i;",
      "            primes.push_back(i);",
      "            phi[i] = i - 1;",
      "            mu[i] = -1;",
      "        }",
      "        for (int p : primes) {",
      "            if (p > spf[i] || 1LL * i * p > n) break;",
      "            spf[i * p] = p;",
      "            if (i % p == 0) {",
      "                phi[i * p] = phi[i] * p;",
      "                mu[i * p] = 0;",
      "                break;",
      "            } else {",
      "                phi[i * p] = phi[i] * (p - 1);",
      "                mu[i * p] = -mu[i];",
      "            }",
      "        }",
      "    }",
      "}"
    ],
    "description": "Linear sieve evaluating Eulers totient phi(x) and M\u00f6bius function mu(x) up to N in strictly O(N) time."
  },
  "Linear Sieve Multi-Function Precomputor": {
    "prefix": "cp-sieve-multi-func",
    "body": [
      "struct LinearSieve {",
      "    int n;",
      "    vector<int> spf, primes, phi, mu;",
      "    LinearSieve(int n_ = 1) : n(n_), spf(n_ + 1, 0), phi(n_ + 1, 0), mu(n_ + 1, 0) {",
      "        phi[1] = mu[1] = 1;",
      "        for (int i = 2; i <= n; i++) {",
      "            if (!spf[i]) spf[i] = i, primes.push_back(i), phi[i] = i - 1, mu[i] = -1;",
      "            for (int p : primes) {",
      "                if (p > spf[i] || (ll)i * p > n) break;",
      "                spf[i * p] = p;",
      "                if (i % p == 0) phi[i * p] = phi[i] * p, mu[i * p] = 0;",
      "                else phi[i * p] = phi[i] * (p - 1), mu[i * p] = -mu[i];",
      "            }",
      "        }",
      "    }",
      "    bool is_prime(int x) const { return x >= 2 && spf[x] == x; }",
      "    vector<pair<int, int>> factorize(int x) const {",
      "        vector<pair<int, int>> f;",
      "        while (x > 1) {",
      "            int p = spf[x], c = 0;",
      "            while (x % p == 0) x /= p, c++;",
      "            f.push_back({p, c});",
      "        }",
      "        return f;",
      "    }",
      "    vector<int> divisors(int x) const {",
      "        vector<int> d = {1};",
      "        for (auto [p, e] : factorize(x)) {",
      "            int sz0 = d.size();",
      "            for (int k = 1, pk = 1; k <= e; k++) {",
      "                pk *= p;",
      "                for (int i = 0; i < sz0; i++) d.push_back(d[i] * pk);",
      "            }",
      "        }",
      "        sort(d.begin(), d.end());",
      "        return d;",
      "    }",
      "};"
    ],
    "description": "Linear sieve precomputing SPF, primes, mobius mu, totient phi, and divisor counts d(n) in O(N) time."
  },
